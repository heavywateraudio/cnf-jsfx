desc:CNF Console Noise Floor 
// FACELIFT-CARD v1
// DSP by Heavy Water Audio/Andy Rx, v.0.1.06
// DSP license: MIT
// GUI by Heavy Water Audio/Andy Rx, v 1.0, MIT
// serial [47bdb600]
// 2026
// contact: heavywateraudio.com
// note:
// made with Facelift v0.1.638
// FACELIFT-CARD END
// =============================================================================
//version: 0.1.06
//
// Controls exposed to the host:
//   slider1:0<0,2,1{Channel,Bus,Master}>Role
//   slider2:0<0,50,1>Noise Floor Level (dB)
//   slider3:0<0,1,1{On,Off}>Noise Floor
//
// CORE LAW: more open channels -> floor rises by power summation,
//   +3 dB per doubling. N_total = sqrt(sum(N_i^2)).
//
// PLACEMENT:
//   Source : CNF(Channel) -> TAMD Channel -> REAPER routing
//   Master : THS Master Summer -> TAMD Master -> CNF(Master) -> limiter
//   *** Never put a stereo CNF before THS Master Summer (pins 1/2 cleared). ***
//
// gmem NAMESPACE: HWACNF (control state only - never audio). Must not
//   touch AnalogMoleculeDeluxe (TAMD) or TheHotSummerNetwork (THS).
//
// gmem MAP:
//   [1]      best-effort global instance counter (id entropy)
//   [2]      published Intensity scalar (Master -> Channels)
//   [3]      published Character (constant 1; Master -> Channels)
//   [4]      Master heartbeat (time_precise)
//   [5]      detected active channel count
//   [6],[7]  Master-claim id / heartbeat (multiple-master guard)
//   [8]      published global soft-bypass state (Master -> followers)
//   [9]      published Noise Floor Level linear gain (Master -> followers)
//   [10]     published Noise Floor Level in dB (display/debug)
//   Channel slot N at CNF_BASE + (N-1)*CNF_STRIDE
//     (N=1..CNF_MAX_SLOTS=180; 10000..15759):
//     +0 heartbeat  +1 active  +2 mute  +3 topology  +12 owner id
//     +13 version   +14 flags(silent)
//   Bus slot N at CNF_BUSROLE_BASE + (N-1)*CNF_STRIDE
//     (N=1..CNF_BUSROLE_SLOTS=8; 16000..16238): same per-slot fields.
//     Bus and Channel use separate pools; Bus publishes no global control word.
//
// CALIBRATION: pink generator auto-calibrated to unit RMS at @init;
//   white is exactly unit RMS (uniform*sqrt(3)). Absolute level lands
//   ~1 dB from mode targets; measure it and trim with the
//   Master Output Trim. Channel-count buildup law is exact regardless.
// =============================================================================

options:gmem=HWACNF
options:no_meter

slider1:0<0,2,1{Channel,Bus,Master}>-Role
slider2:0<0,50,1>-Noise Floor Level (dB)
slider3:0<0,1,1{On,Off}>-Noise Floor

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

// === FACELIFT BEGIN sliders v3 ===
options:no_meter
slider6:0<0,10,1>-Numbox3
// === FACELIFT END sliders ===
@init
ext_noinit = 1; // preserve internal role/product state across transport/@init cycles

CNF_MAX_SLOTS = 180;
CNF_BASE      = 10000;
CNF_STRIDE    = 32;
CNF_BUSROLE_BASE  = 16000;  // Bus-role slot pool base (separate from Channel pool 10000..15759)
CNF_BUSROLE_SLOTS = 8;      // Bus-role pool capacity (HWA Integrator compatibility)
CNF_VERSION   = 451;   // version tag written to slot+13
TIMEOUT       = 1.0;    // s, liveness window
SETTLE        = 0.06;   // s, auto-slot claim verify delay

// Exact 1/2^32: multiplying by it equals dividing by 2^32.
CNF_INV_2P32  = 0.00000000023283064365386962890625;

function db2lin(db) ( 10^(db*0.05); );

// float-safe 32-bit LCG, returns uniform [-1,+1)
// (multiplies by CNF_INV_2P32, exactly 1/2^32)
function nrand(s*) (
  s.v = s.v * 1664525 + 1013904223;
  s.v = s.v - floor(s.v * CNF_INV_2P32) * 4294967296;
  s.v * CNF_INV_2P32 * 2 - 1;
);
function seed_state(s* k) ( s.v = k - floor(k * CNF_INV_2P32) * 4294967296; );

// Paul Kellet refined (7-pole) pink filter
function pink_next(p* w) (
  p.b0 = 0.99886*p.b0 + w*0.0555179;
  p.b1 = 0.99332*p.b1 + w*0.0750759;
  p.b2 = 0.96900*p.b2 + w*0.1538520;
  p.b3 = 0.86650*p.b3 + w*0.3104856;
  p.b4 = 0.55000*p.b4 + w*0.5329522;
  p.b5 = -0.7616*p.b5 - w*0.0168980;
  p.o  = p.b0+p.b1+p.b2+p.b3+p.b4+p.b5+p.b6 + w*0.5362;
  p.b6 = w*0.115926;
  p.o;
);

// 1-pole HP (x - LP) -> 1-pole LP -> DC block
function shape(f* x) (
  f.hpz = f.hpz + f.ahp*(x - f.hpz);
  x = x - f.hpz;
  f.lpz = f.lpz + f.alp*(x - f.lpz);
  x = f.lpz;
  f.dcy = x - f.dcx + 0.9997*f.dcy;
  f.dcx = x;
  f.dcy;
);

function cnf_dbstr(out val) (
  val > 0.5 ? sprintf(out, "+%.0f dB", val) : strcpy(out, "0 dB");
);

smc   = 1 - exp(-1 / (srate*0.15));   // ~150 ms level smoothing
SQRT3 = 1.7320508075688772;

// --- auto-calibrate pink to unit RMS ---
seed_state(cal_rng, 2246822519);
loop(2048, pink_next(cal_pk, nrand(cal_rng)*SQRT3); );
acc = 0; calN = 32768;
loop(calN, pv = pink_next(cal_pk, nrand(cal_rng)*SQRT3); acc += pv*pv; );
prms = sqrt(acc / calN);
PINK_NORM = prms > 0 ? 1/prms : 1;

// --- strong-entropy unique instance id ---
// With ext_noinit, keep the same id through transport/@init cycles so a Master
// does not appear as a new/competing instance when playback starts. New plugin
// instances still start with my_id==0 and get a fresh id.
my_id <= 0 ? (
  gmem[1] = gmem[1] + 1;
  tnow = time_precise();
  seedmix = floor(tnow*1000000);
  my_id = (seedmix - floor(seedmix/1000000000)*1000000000)
          + floor(rand(1000000))*1000 + gmem[1]*7;
  my_id = floor(my_id) + 1;   // nonzero
);

sbase = my_id*2654 + 1;
seed_state(rw_l, sbase+11);   seed_state(rp_l, sbase+97);
seed_state(rw_r, sbase+1013); seed_state(rp_r, sbase+5077);
// Bus shared (L/R-correlated) component streams - distinct from L/R independent streams.
// This produces an intra-instance L/R common noise (a summing-bus electronics layer),
// NOT inter-instance sharing and NOT a mono collapse.
seed_state(rw_s, sbase+2027); seed_state(rp_s, sbase+3041);
loop(16, nrand(rw_l); nrand(rp_l); nrand(rw_r); nrand(rp_r); nrand(rw_s); nrand(rp_s); );

// Runtime state can reset on @init; product state below is guarded.
my_slot=0; held_slot=0; claim_state=0; claim_time=0; backoff_until=0;
prev_topology=-1; prev_service=-1; prev_sslot=-1;
cur_rms=0; tgt_rms=0; humph=0; dbg_count=0; dbg_highest=0;
cnf_silent_cleared=0;  // one-shot idle-clear flag; runtime only, never saved
multi_seen=-100; multi_active=0; ms_prev=0;
slots_full=0; slots_used=0;
// Bus-role runtime state (transient; not serialized). Reset on @init like Channel state.
bus_my_slot=0; bus_held_slot=0; bus_claim_state=0; bus_claim_time=0; bus_backoff_until=0;
bus_slots_full=0; bus_full_latched=0; bus_assigned_count=0; bus_available_count=CNF_BUSROLE_SLOTS; bus_display_num=0;
bus_act_env=0; bus_act_gain=1; bus_base_rms=0; bus_emit=0;

// Noise Floor Level runtime (smoothed gain; targets recomputed per block). nl_gain starts at
// unity so a 0 dB instance is bit-identical; a saved boost ramps in over ~50 ms (inaudible).
nl_gain=1; nl_target=1; nl_smc=0;
abcomp_gain=1; abcomp_target=1; abcomp_smc=0; abcomp_noise_rms=0;

// Product state: initialize only once per instance. Do not reset these on
// transport start, automation mode changes, or other @init cycles.
cnf_state_inited != 1 ? (
  topology = 0;
  master_role_locked = 0;
  master_latch = 0;        // panel intent; @block derives topology from this only
  follower_role = 0;       // 0=Channel, 1=Bus. Panel intent for the FOLLOWER role.
                           // Ignored once master_latch==1 (Master lock dominates).
  character = 1;           // legacy compat var; forced to 1 and never affects audio
  cnf_bypass = 0;          // internal state: 0=Noise Floor ON
  hum_sel = 0;             // Hum UI removed; keep legacy var serialized but forced off
  cnf_noise_level_db = 0;  // Master Noise Floor Level boost, dB (0..+50). Default 0.0.
  cnf_abcomp = 0;          // A/B level compensation is disabled in this build.
  cnf_state_inited = 1;
);

gfx_ext_flags = gfx_ext_flags | 256;
pub_int=0;

// === FACELIFT BEGIN init v1 ===
// === FACELIFT JOIN v1 47bdb600-195b-4231-bfcb-3e2a4759903d ===

runtime_scale = 1.0;
runtime_dim = 1;
runtime_drag_throw = 200;
runtime_ox = 0;
runtime_oy = 0;
runtime_text_sign = 0;

RUNTIME_SLOT_FACEPLATE_GRAD_TOP = 0;
RUNTIME_SLOT_FACEPLATE_GRAD_BOTTOM = 12;
RUNTIME_SLOT_FACEPLATE_LIGHT_EDGE = 321;
RUNTIME_SLOT_FACEPLATE_DARK_EDGE = 333;
RUNTIME_SLOT_BUTTON_FILL = 22;
RUNTIME_SLOT_BUTTON_ACCENT = 34;
RUNTIME_SLOT_BUTTON_TEXT = 46;
RUNTIME_SLOT_BUTTON_FILL_ON = 58;
RUNTIME_SLOT_BUTTON_ACCENT_ON = 70;
RUNTIME_SLOT_BUTTON_TEXT_ON = 82;
RUNTIME_SLOT_BUTTON_LIGHT_EDGE = 347;
RUNTIME_SLOT_BUTTON_DARK_EDGE = 359;
RUNTIME_SLOT_BUTTON_FILL_BUTTON_OFF_HOVER = 503;
RUNTIME_SLOT_BUTTON_FILL_BUTTON_ON_HOVER = 515;
RUNTIME_SLOT_KNOB_RING = 88;
RUNTIME_SLOT_KNOB_HOVER = 100;
RUNTIME_SLOT_KNOB_POINTER = 112;
RUNTIME_SLOT_KNOB_LABEL_TEXT = 124;
RUNTIME_SLOT_KNOB_INNER_RING = 290;
RUNTIME_SLOT_KNOB_INNER_FILL = 302;
RUNTIME_SLOT_KNOB_OUTER_FILL = 314;
RUNTIME_SLOT_KNOB_LIGHT_EDGE = 370;
RUNTIME_SLOT_KNOB_DARK_EDGE = 382;
RUNTIME_SLOT_KNOB_NEGATIVE = 460;
RUNTIME_SLOT_KNOB_POSITIVE = 472;
RUNTIME_SLOT_LABEL_TEXT = 132;
RUNTIME_SLOT_LABEL_TEXT_ON = 265;
RUNTIME_SLOT_NUMBOX_FILL = 143;
RUNTIME_SLOT_NUMBOX_ACCENT = 155;
RUNTIME_SLOT_NUMBOX_TEXT = 167;
RUNTIME_SLOT_NUMBOX_EDIT_FILL = 179;
RUNTIME_SLOT_NUMBOX_EDIT_TEXT = 191;
RUNTIME_SLOT_NUMBOX_LABEL_TEXT = 203;
RUNTIME_SLOT_NUMBOX_LIGHT_EDGE = 391;
RUNTIME_SLOT_NUMBOX_DARK_EDGE = 403;
RUNTIME_SLOT_NUMBOX_NEGATIVE = 481;
RUNTIME_SLOT_NUMBOX_POSITIVE = 493;
RUNTIME_SLOT_METER_ZONE1 = 209;
RUNTIME_SLOT_METER_ZONE2 = 221;
RUNTIME_SLOT_METER_ZONE3 = 233;
RUNTIME_SLOT_METER_OFF = 278;
RUNTIME_SLOT_METER_LIGHT_EDGE = 411;
RUNTIME_SLOT_METER_DARK_EDGE = 423;
RUNTIME_SLOT_LED_ON = 242;
RUNTIME_SLOT_LED_OFF = 254;
RUNTIME_SLOT_LED_LIGHT_EDGE = 431;
RUNTIME_SLOT_LED_DARK_EDGE = 443;

RUNTIME_STATE_IDLE = 0;
RUNTIME_STATE_HOVER = 1;
RUNTIME_STATE_ACTIVE = 2;
RUNTIME_STATE_DISABLED = 3;

function runtime_set_scale(scale)
  local(s)
(
  s = scale;
  (s * 0 == 0 && s > 0) ? (
    runtime_scale = s;
    runtime_scale;
  ) : (
    0;
  );
);

function runtime_x(v) ( v * runtime_scale - runtime_ox; );
function runtime_y(v) ( v * runtime_scale - runtime_oy; );
function runtime_w(v) ( v * runtime_scale; );
function runtime_h(v) ( v * runtime_scale; );
function runtime_s(v) ( v * runtime_scale; );

function runtime_sf(v) ( floor(v * runtime_scale + 0.5); );

function runtime_text_style(font, flags)
(
  runtime_text_font = font;
  runtime_text_flags = flags;
);

function runtime_text_font_private(px)
  local(f)
(
  f = 0;
  (runtime_text_flags & 1) ? f = f * 256 + 'b';
  (runtime_text_flags & 2) ? f = f * 256 + 'i';
  (runtime_text_flags & 4) ? f = f * 256 + 'u';
  gfx_setfont(1 + (px % 16),
    runtime_text_font == 1 ? "Verdana" : (
    runtime_text_font == 2 ? "Tahoma" : (
    runtime_text_font == 3 ? "Trebuchet MS" : (
    runtime_text_font == 4 ? "Georgia" : (
    runtime_text_font == 5 ? "Times New Roman" : (
    runtime_text_font == 6 ? "Courier New" : (
    runtime_text_font == 7 ? "Impact" : "Arial")))))),
    px, f);
);

function runtime_text_cap_ink_private(px)
  local(key, d0, m0, w, h, y, x, r, g, b, top, bot, hit)
(
  key = (runtime_text_font * 4096 + px) * 32 + runtime_text_flags + 1;
  key != runtime_text_cap_key ? (
    gfx_measurestr("H", w, h);
    w = ceil(w) + 2; h = ceil(h) + 2;
    d0 = gfx_dest; m0 = gfx_mode;
    gfx_setimgdim(125, 0, 0);
    gfx_setimgdim(125, w, h);
    gfx_dest = 125; gfx_mode = 0;
    gfx_set(0, 0, 0, 1); gfx_rect(0, 0, w, h);
    gfx_set(1, 1, 1, 1); gfx_x = 1; gfx_y = 1; gfx_drawstr("H");
    top = -1; bot = -1; y = 0;
    loop(h,
      hit = 0; x = 0;
      loop(w, gfx_x = x; gfx_y = y; gfx_getpixel(r, g, b); r > 0.5 ? hit = 1; x += 1;);
      hit ? (top < 0 ? top = y; bot = y;);
      y += 1;
    );
    gfx_dest = d0; gfx_mode = m0;
    runtime_text_cap_mid = top >= 0 ? (top + bot + 1) * 0.5 - 1 : h * 0.5 - 1;
    runtime_text_cap_key = key;
  );
  runtime_text_cap_mid;
);

function runtime_text_ink_private(px)
  local(key, d0, m0, w, h, y, x, r, g, b, top, bot, hit)
(
  key = (runtime_text_font * 4096 + px) * 32 + runtime_text_flags + 1;
  key != runtime_text_ink_key ? (
    gfx_measurestr("0", w, h);
    w = ceil(w) + 2; h = ceil(h) + 2;
    d0 = gfx_dest; m0 = gfx_mode;
    gfx_setimgdim(125, 0, 0);
    gfx_setimgdim(125, w, h);
    gfx_dest = 125; gfx_mode = 0;
    gfx_set(0, 0, 0, 1); gfx_rect(0, 0, w, h);
    gfx_set(1, 1, 1, 1); gfx_x = 1; gfx_y = 1; gfx_drawstr("0");
    top = -1; bot = -1; y = 0;
    loop(h,
      hit = 0; x = 0;
      loop(w, gfx_x = x; gfx_y = y; gfx_getpixel(r, g, b); r > 0.5 ? hit = 1; x += 1;);
      hit ? (top < 0 ? top = y; bot = y;);
      y += 1;
    );
    gfx_dest = d0; gfx_mode = m0;
    runtime_text_ink_mid = top >= 0 ? (top + bot + 1) * 0.5 - 1 : h * 0.5 - 1;
    runtime_text_ink_key = key;
  );
  runtime_text_ink_mid;
);

function runtime_text_draw_private(str, measure, upper)
  local(s, n, c, w, h, x0, y0, r0, g0, b0, ox)
(
  s = str;
  (upper && (runtime_text_flags & 16)) ? (
    strcpy(#runtime_text_buf, str);
    n = 0;
    loop(strlen(#runtime_text_buf),
      c = str_getchar(#runtime_text_buf, n, 'cu');
      (c >= 97 && c <= 122) ? str_setchar(#runtime_text_buf, n, c - 32, 'cu');
      n += 1;
    );
    s = #runtime_text_buf;
  );
  measure ? (
    gfx_measurestr(s, w, h);
    w;
  ) : (
    (runtime_text_flags & 8) ? (
      x0 = gfx_x; y0 = gfx_y;
      r0 = gfx_r; g0 = gfx_g; b0 = gfx_b;
      ox = max(1, runtime_sf(1));
      gfx_r = 0; gfx_g = 0; gfx_b = 0;
      gfx_x = x0 + ox; gfx_y = y0 + ox;
      gfx_drawstr(s);
      gfx_r = r0; gfx_g = g0; gfx_b = b0;
      gfx_x = x0; gfx_y = y0;
    );
    gfx_drawstr(s);
    0;
  );
);

function runtime_hit(mx, my, x, y, w, h)
(
  mx >= runtime_x(x) && mx <= runtime_x(x) + runtime_w(w) &&
  my >= runtime_y(y) && my <= runtime_y(y) + runtime_h(h);
);

function runtime_rr_fill(x, y, w, h, r)
(
  r = min(r, floor(min(w, h) / 2));
  gfx_rect(x + r, y, w - r * 2, h);
  gfx_rect(x, y + r, w, h - r * 2);
  r >= 1 ? (
    gfx_circle(x + r - 1, y + r - 1, r - 1, 1, 1);
    gfx_circle(x + w - r, y + r - 1, r - 1, 1, 1);
    gfx_circle(x + r - 1, y + h - r, r - 1, 1, 1);
    gfx_circle(x + w - r, y + h - r, r - 1, 1, 1);
  );
);

function runtime_color_seed_private()
  local(addr)
(
  !runtime_color_seeded ? (
    addr = RUNTIME_ARENA_BASE + RUNTIME_COLOR_OFF;
    loop(RUNTIME_COLOR_WIDTH / 8,
      addr[0] = -1;
      addr[1] = -1;
      addr[2] = -1;
      addr[3] = -1;
      addr[4] = -1;
      addr[5] = -1;
      addr[6] = -1;
      addr[7] = -1;
      addr += 8;
    );
    runtime_color_seeded = 1;
  );
);

function runtime_color_default_private(row, channel)
(
  channel == 3 ? 1 :
  channel == 0 ? (
    row == 0  ? 0.078431 :
    row == 1  ? 0.027451 :
    row == 2  ? 0.384314 :
    row == 3  ? 0.94902  :
    row == 4  ? 0.921569 :
    row == 5  ? 0.737255 :
    row == 6  ? 1        :
    row == 7  ? 0.117647 :
    row == 8  ? 0.54902  :
    row == 9  ? 0.701961 :
    row == 10 ? 0.921569 :
    row == 11 ? 0.780392 :
    row == 12 ? 0.780392 :
    row == 13 ? 0.160784 :
    row == 14 ? 0.94902  :
    row == 15 ? 0.921569 :
    row == 16 ? 0.286275 :
    row == 17 ? 0.980392 :
    row == 18 ? 0.780392 :
    row == 19 ? 0        :
    row == 20 ? 1        :
    row == 21 ? 1        :
    row == 22 ? 1        :
    row == 23 ? 0.321569 :
    row == 24 ? 0.780392 :
    row == 26 ? 0.54902 :
    row == 27 ? 0.078431 :
    row == 28 ? 0.027451 :
    row == 29 ? 1        :
    row == 30 ? 0        :
    row == 31 ? 1        :
    row == 32 ? 0        :
