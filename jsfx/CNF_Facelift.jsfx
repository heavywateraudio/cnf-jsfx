  ph = floor(runtime_y(y + h)) - py;
  pr = floor(runtime_s(r));
  (pw > 0 && ph > 0) ? (
    i = 0;
    loop(ph,
      t = i / max(1, ph - 1);
      dx = 0;
      i < pr ? dx = runtime_faceplate_inset_private(pr, pr - i);
      i > ph - 1 - pr ? dx = runtime_faceplate_inset_private(pr, i - (ph - 1 - pr));
      runtime_color_literal(top_r, top_g, top_b, top_a, bot_r, bot_g, bot_b, bot_a, t,
                           RUNTIME_STATE_IDLE);
      gfx_rect(px + dx, py + i, pw - dx * 2, 1);
      i += 1;
    );
  );
);

function runtime_button_addr_private(widget_id)
(
  RUNTIME_ARENA_BASE + RUNTIME_WIDGET_OFF + (widget_id - 1) * 8;
);

function runtime_button_decimals_private(vstep)
  local(d, i, s)
(
  vstep == 0 ? 2 : (
    d = 6;
    i = 6;
    loop(7,
      s = abs(vstep) * pow(10, i);
      abs(s - floor(s + 0.5)) <= 0.000000001 ? d = i;
      i -= 1;
    );
    d;
  );
);

function runtime_button_init(widget_id, value, enabled, flags, vmin, vmax, vstep)
  local(a)
(
  a = runtime_button_addr_private(widget_id);
  a[3] = vmin;
  a[4] = vmax;
  a[5] = vstep;
  a[6] = runtime_button_decimals_private(vstep);
  a[0] = min(max(value, vmin), vmax);
  a[1] = enabled != 0 ? 1 : 0;
  a[2] = flags;
  a[7] = -1;
);

function runtime_button_init_radio(widget_id, value, enabled, flags, vmin, vmax, vstep, radio_value)
  local(a)
(
  runtime_button_init(widget_id, value, enabled, flags, vmin, vmax, vstep);
  a = runtime_button_addr_private(widget_id);
  a[7] = radio_value;
);

function runtime_button_get(widget_id)
  local(a)
(
  a = runtime_button_addr_private(widget_id);
  a[0];
);

function runtime_button_set(widget_id, value)
  local(a)
(
  a = runtime_button_addr_private(widget_id);
  a[0] = min(max(value, a[3]), a[4]);
);

function runtime_button_set_enabled(widget_id, enabled)
  local(a)
(
  a = runtime_button_addr_private(widget_id);
  a[1] = enabled != 0 ? 1 : 0;
);

function runtime_button_state(widget_id, owner_id, mx, my, x, y, w, h)
  local(a)
(
  a = runtime_button_addr_private(widget_id);
  a[1] == 0 ? RUNTIME_STATE_DISABLED :
  owner_id == widget_id ? RUNTIME_STATE_ACTIVE :
  owner_id == 0 && runtime_hit(mx, my, x, y, w, h) ? RUNTIME_STATE_HOVER :
  RUNTIME_STATE_IDLE;
);

function runtime_button_mouse(widget_id, owner_id, down, up, mx, my, x, y, w, h)
  local(a, m, v0, v1)
(
  a = runtime_button_addr_private(widget_id);
  v0 = a[0];
  v1 = v0;
  (a[1] != 0 && owner_id == widget_id) ? (
    m = a[2] & 7;
    m == 1 ? (
      (up && runtime_hit(mx, my, x, y, w, h)) ? (
        v1 = v0 >= (a[3] + a[4]) * 0.5 ? a[3] : a[4];
      );
    ) : m == 0 ? (
      down ? ( v1 = a[4]; );
      up ? ( v1 = a[3]; );
    ) : m == 2 ? (
      down ? ( v1 = a[4]; );
    ) : m == 3 ? (
      down ? ( v1 = a[3]; );
    ) : m == 4 ? (
      down ? ( v1 = min(max(a[7], a[3]), a[4]); );
    );
  );
  a[0] = v1;
  v1 != v0;
);

function runtime_button_mouse_all(widget_id, owner_id, down, up, mx, my, x, y, w, h, target)
  local(a, v0)
(
  a = runtime_button_addr_private(widget_id);
  v0 = a[0];
  (a[1] != 0 && owner_id == widget_id && down && (a[2] & 7) == 4 && v0 == a[7]) ? (
    a[0] = min(max(target, a[3]), a[4]);
    a[0] != v0;
  ) : (
    runtime_button_mouse(widget_id, owner_id, down, up, mx, my, x, y, w, h);
  );
);

function runtime_button_press_private(f)
(
  gfx_r = min(runtime_dim, max(0, gfx_r * f));
  gfx_g = min(runtime_dim, max(0, gfx_g * f));
  gfx_b = min(runtime_dim, max(0, gfx_b * f));
);

function runtime_button_draw(id, x, y, w, h, radius, accent_px, font_px, state, on, str, press_light, press_factor)
  local(px, py, pw, ph, pr, pa, tw, th, s_fill, s_accent, s_text, rr, i, t, dx,
        dy, ba, go, cov, m, lit, ps)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  pr = floor(runtime_s(radius));
  pa = min(floor(runtime_x(x + accent_px)) - px, pw);
  (pw > 0 && ph > 0) ? (
    lit = state == RUNTIME_STATE_ACTIVE && press_light != 0;
    ps = state == RUNTIME_STATE_DISABLED ? RUNTIME_STATE_DISABLED : RUNTIME_STATE_IDLE;
    s_fill = (state == RUNTIME_STATE_HOVER || lit) ?
      (on ? RUNTIME_SLOT_BUTTON_FILL_BUTTON_ON_HOVER : RUNTIME_SLOT_BUTTON_FILL_BUTTON_OFF_HOVER) :
      (on ? RUNTIME_SLOT_BUTTON_FILL_ON : RUNTIME_SLOT_BUTTON_FILL);
    s_accent = on ? RUNTIME_SLOT_BUTTON_ACCENT_ON : RUNTIME_SLOT_BUTTON_ACCENT;
    s_text = on ? RUNTIME_SLOT_BUTTON_TEXT_ON : RUNTIME_SLOT_BUTTON_TEXT;
    rr = min(pr, floor(min(pw, ph) / 2));
    i = 0;
    loop(ph,
      t = i / max(1, ph - 1);
      runtime_color_apply(id, s_fill, t, ps);
      lit ? runtime_button_press_private(press_factor);
      dy = max(rr - i - 0.5, i + 0.5 - (ph - rr));
      dx = 0;
      dy > 0 ? (
        ba = gfx_a;
        go = 1;
        loop(rr,
          go ? (
            cov = rr + 0.5 - sqrt((rr - dx - 0.5) * (rr - dx - 0.5) + dy * dy);
            cov >= 1 ? go = 0 : (
              cov > 0 ? (
                gfx_a = ba * cov;
                gfx_rect(px + dx, py + i, 1, 1);
                gfx_rect(px + pw - 1 - dx, py + i, 1, 1);
              );
              dx += 1;
            );
          );
        );
        gfx_a = ba;
      );
      gfx_rect(px + dx, py + i, pw - dx * 2, 1);
      i += 1;
    );
    (pa > 0 && ph - pr * 2 > 0) ? (
      runtime_color_apply(id, s_accent, 0, ps);
      gfx_rect(px, py + pr, pa, ph - pr * 2);
    );
    strlen(str) > 0 ? (
      runtime_text_font_private(runtime_sf(font_px));
      gfx_measurestr(str, tw, th);
      tw = runtime_text_draw_private(str, 1, 1);
      m = runtime_text_cap_ink_private(runtime_sf(font_px));
      gfx_x = px + floor((pw - tw) * 0.5);
      gfx_y = floor(py + ph * 0.5 - m);
      runtime_color_apply(id, s_text, 0, ps);
      runtime_text_draw_private(str, 0, 1);
    );
  );
  runtime_text_style(0, 0);
);

function runtime_button_colors_literal(fill_b_r, fill_b_g, fill_b_b, fill_b_a, fill_on_b_r, fill_on_b_g, fill_on_b_b, fill_on_b_a, off_hover_a_r, off_hover_a_g, off_hover_a_b, off_hover_a_a, off_hover_b_r, off_hover_b_g, off_hover_b_b, off_hover_b_a, on_hover_a_r, on_hover_a_g, on_hover_a_b, on_hover_a_a, on_hover_b_r, on_hover_b_g, on_hover_b_b, on_hover_b_a)
