    ls = kind == 1 ? RUNTIME_SLOT_FACEPLATE_LIGHT_EDGE : kind == 2 ? RUNTIME_SLOT_BUTTON_LIGHT_EDGE : kind == 3 ? RUNTIME_SLOT_KNOB_LIGHT_EDGE : kind == 5 ? RUNTIME_SLOT_NUMBOX_LIGHT_EDGE : kind == 6 ? RUNTIME_SLOT_METER_LIGHT_EDGE : RUNTIME_SLOT_LED_LIGHT_EDGE;
    ds = kind == 1 ? RUNTIME_SLOT_FACEPLATE_DARK_EDGE : kind == 2 ? RUNTIME_SLOT_BUTTON_DARK_EDGE : kind == 3 ? RUNTIME_SLOT_KNOB_DARK_EDGE : kind == 5 ? RUNTIME_SLOT_NUMBOX_DARK_EDGE : kind == 6 ? RUNTIME_SLOT_METER_DARK_EDGE : RUNTIME_SLOT_LED_DARK_EDGE;
    runtime_color_seed_private();
    slot = ls; row = floor(slot / 11); addr = RUNTIME_ARENA_BASE + RUNTIME_COLOR_OFF + (id - 1) * 88 + (slot - row * 11) * 8;
    addr[0] == -1 && addr[1] == -1 && addr[2] == -1 && addr[3] == -1 && addr[4] == -1 && addr[5] == -1 && addr[6] == -1 && addr[7] == -1 ? (
      lr0 = runtime_color_default_private(row, 0); lg0 = runtime_color_default_private(row, 1); lb0 = runtime_color_default_private(row, 2); la0 = runtime_color_default_private(row, 3);
      lr1 = lr0; lg1 = lg0; lb1 = lb0; la1 = la0;
    ) : (lr0 = addr[0]; lg0 = addr[1]; lb0 = addr[2]; la0 = addr[3]; lr1 = addr[4]; lg1 = addr[5]; lb1 = addr[6]; la1 = addr[7];);
    slot = ds; row = floor(slot / 11); addr = RUNTIME_ARENA_BASE + RUNTIME_COLOR_OFF + (id - 1) * 88 + (slot - row * 11) * 8;
    addr[0] == -1 && addr[1] == -1 && addr[2] == -1 && addr[3] == -1 && addr[4] == -1 && addr[5] == -1 && addr[6] == -1 && addr[7] == -1 ? (
      dr0 = runtime_color_default_private(row, 0); dg0 = runtime_color_default_private(row, 1); db0 = runtime_color_default_private(row, 2); da0 = runtime_color_default_private(row, 3);
      dr1 = dr0; dg1 = dg0; db1 = db0; da1 = da0;
    ) : (dr0 = addr[0]; dg0 = addr[1]; db0 = addr[2]; da0 = addr[3]; dr1 = addr[4]; dg1 = addr[5]; db1 = addr[6]; da1 = addr[7];);
    runtime_skirt_draw_literal(kind, x, y, w, h, led_shape, show, width, gap, corner, opacity_a, opacity_b, lr0, lg0, lb0, la0, lr1, lg1, lb1, la1, dr0, dg0, db0, da0, dr1, dg1, db1, da1);
  );
);

runtime_geom_count = 0;

function runtime_geom_addr(id)
(
  RUNTIME_ARENA_BASE + RUNTIME_GEOM_OFF + (id - 1) * 4;
