function runtime_color_literal(a_r, a_g, a_b, a_a, b_r, b_g, b_b, b_a, t, state)
  local(factor, r, g, b, a)
(
  r = a_r + (b_r - a_r) * t;
  g = a_g + (b_g - a_g) * t;
  b = a_b + (b_b - a_b) * t;
  a = a_a + (b_a - a_a) * t;

  factor = runtime_color_state_factor_private(state);
  r = min(1, max(0, r * factor));
  g = min(1, max(0, g * factor));
  b = min(1, max(0, b * factor));

  gfx_set(r * runtime_dim, g * runtime_dim, b * runtime_dim, a);
);

function runtime_set_drag_throw(px)
  local(p)
(
  p = px;
  (p * 0 == 0 && p > 0) ? (
    runtime_drag_throw = p;
    runtime_drag_throw;
