    0;
  );
);

function runtime_skirt_draw_literal(kind, x, y, w, h, led_shape, show, width, gap, corner, opacity_a, opacity_b, light_a_r, light_a_g, light_a_b, light_a_a, light_b_r, light_b_g, light_b_b, light_b_a, dark_a_r, dark_a_g, dark_a_b, dark_a_a, dark_b_r, dark_b_g, dark_b_b, dark_b_a)
  local(cx, cy, hw, hh, r, d, qx, qy, inner, outer, t, angle, mix, px, py, x0, x1, y0, y1, lr, lg, lb, la, dr, dg, db, da, circular,
        ie, oe, cov, bx, by, bw, bh, nx, ny, nl, aa, ab, ca)
(
  show && width > 0 && w > 0 && h > 0 && (kind == 1 || kind == 2 || kind == 3 || kind == 5 || kind == 6 || kind == 7) ? (
    bx = floor(runtime_x(x)); by = floor(runtime_y(y));
    bw = floor(runtime_x(x + w)) - bx; bh = floor(runtime_y(y + h)) - by;
    cx = bx + bw / 2; cy = by + bh / 2;
    hw = bw / 2; hh = bh / 2;
    circular = kind == 3 || (kind == 7 && led_shape == 0);
    circular ? (hw = min(hw, hh); hh = hw;);
    kind == 1 ? (hw -= runtime_s(gap); hh -= runtime_s(gap););
    r = circular ? hw : (kind == 1 ? min(max(0, runtime_s(corner)), max(0, min(hw, hh))) : (kind == 2 || kind == 5 ? min(max(0, floor(runtime_s(corner))), floor(min(bw, bh) / 2)) : 0));
    inner = kind == 1 ? -runtime_s(width) : runtime_s(gap);
    outer = kind == 1 ? 0 : runtime_s(gap + width);
    ie = inner - 0.5; oe = outer + 0.5;
    (hw + outer > 0 && hh + outer > 0 && outer > inner) ? (
      x0 = max(0, floor(cx - hw - max(0, oe)));
      y0 = max(0, floor(cy - hh - max(0, oe)));
      x1 = min(gfx_w, ceil(cx + hw + max(0, oe)));
      y1 = min(gfx_h, ceil(cy + hh + max(0, oe)));
      py = y0;
      loop(max(0, y1 - y0),
        circular = 0;
        loop(2,
          qx = abs(py + 0.5 - cy);
          qy = max(0, r + oe);
          lr = -1;
          (qy > 0 && qx <= hh - r && hh + oe > 0) ? lr = hw + oe;
          (qy > 0 && qx > hh - r && qx <= hh + oe) ?
            lr = hw - r + sqrt(max(0, qy^2 - (qx - (hh - r))^2));
          (qy <= 0 && qx <= hh + oe && hw + oe >= 0) ? lr = hw + oe;
          t = max(0, r + ie);
          lg = -1;
          (t > 0 && qx <= hh - r && hh + ie > 0) ? lg = hw + ie;
          (t > 0 && qx > hh - r && qx <= hh + ie) ?
            lg = hw - r + sqrt(max(0, t^2 - (qx - (hh - r))^2));
          (t <= 0 && qx <= hh + ie && hw + ie >= 0) ? lg = hw + ie;
          lr >= 0 ? (
            circular == 0 ? (
              px = max(x0, floor(cx - lr - 0.5));
              y1 = min(x1, ceil(cx - lg - 0.5) + 1);
              y1 = min(y1, floor(cx) + 1);
            ) : (
              px = max(x0, floor(cx + lg - 0.5));
              px = max(px, floor(cx) + 1);
              y1 = min(x1, ceil(cx + lr - 0.5) + 1);
            );
            loop(max(0, y1 - px),
              qx = abs(px + 0.5 - cx) - hw + r;
              qy = abs(py + 0.5 - cy) - hh + r;
              d = min(max(qx, qy), 0) + sqrt(max(qx, 0)^2 + max(qy, 0)^2) - r;
              cov = min(outer, d + 0.5) - max(inner, d - 0.5);
              cov > 0 ? (
                d = min(outer, max(inner, d));
                t = kind == 1 ? (outer - d) / (outer - inner) : (d - inner) / (outer - inner);
                (qx > 0 || qy > 0) ? (
                  nx = max(qx, 0); ny = max(qy, 0);
                ) : (
                  qx > qy ? (nx = 1; ny = 0;) : (qy > qx ? (nx = 0; ny = 1;) : (nx = 1; ny = 1;));
                );
                nx *= sign(px + 0.5 - cx); ny *= sign(py + 0.5 - cy);
                nl = sqrt(nx * nx + ny * ny);
                mix = nl > 0 ? (1 - (nx + ny) / (sqrt(2) * nl)) * 0.5 : 0.5;
                aa = light_a_a * opacity_a; ab = light_b_a * opacity_b;
                la = aa + (ab - aa) * t;
                la > 0 ? (
                  lr = (light_a_r * aa + (light_b_r * ab - light_a_r * aa) * t) / la;
                  lg = (light_a_g * aa + (light_b_g * ab - light_a_g * aa) * t) / la;
                  lb = (light_a_b * aa + (light_b_b * ab - light_a_b * aa) * t) / la;
                ) : (lr = 0; lg = 0; lb = 0;);
                aa = dark_a_a * opacity_a; ab = dark_b_a * opacity_b;
                da = aa + (ab - aa) * t;
                da > 0 ? (
                  dr = (dark_a_r * aa + (dark_b_r * ab - dark_a_r * aa) * t) / da;
                  dg = (dark_a_g * aa + (dark_b_g * ab - dark_a_g * aa) * t) / da;
                  db = (dark_a_b * aa + (dark_b_b * ab - dark_a_b * aa) * t) / da;
                ) : (dr = 0; dg = 0; db = 0;);
                ca = da + (la - da) * mix;
                ca > 0 ? (
                  runtime_color_literal(
                    (dr * da + (lr * la - dr * da) * mix) / ca,
                    (dg * da + (lg * la - dg * da) * mix) / ca,
                    (db * da + (lb * la - db * da) * mix) / ca, ca,
                    (dr * da + (lr * la - dr * da) * mix) / ca,
                    (dg * da + (lg * la - dg * da) * mix) / ca,
                    (db * da + (lb * la - db * da) * mix) / ca, ca,
                    0, RUNTIME_STATE_IDLE);
                  gfx_a *= min(1, cov);
                  gfx_rect(px, py, 1, 1);
                );
              );
              px += 1;
            );
          );
          circular += 1;
        );
        py += 1;
      );
    );
  );
);

function runtime_skirt_draw(id, kind, x, y, w, h, led_shape, show, width, gap, corner, opacity_a, opacity_b)
  local(ls, ds, slot, row, addr, lr0, lg0, lb0, la0, lr1, lg1, lb1, la1, dr0, dg0, db0, da0, dr1, dg1, db1, da1)
