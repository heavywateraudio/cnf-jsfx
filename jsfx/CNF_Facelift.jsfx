function runtime_faceplate_inset_private(pr, dy)
(
  pr - floor(sqrt(pr * pr - dy * dy));
);

function runtime_faceplate_draw(id, x, y, w, h, r)
  local(px, py, pw, ph, pr, i, t, dx)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  pr = floor(runtime_s(r));
  (pw > 0 && ph > 0) ? (
    i = 0;
    loop(ph,
      t = i / max(1, ph - 1);
      dx = 0;
      i < pr ? dx = runtime_faceplate_inset_private(pr, pr - i);
      i > ph - 1 - pr ? dx = runtime_faceplate_inset_private(pr, i - (ph - 1 - pr));
      runtime_color_apply2(id, RUNTIME_SLOT_FACEPLATE_GRAD_TOP,
                           RUNTIME_SLOT_FACEPLATE_GRAD_BOTTOM, t,
                           RUNTIME_STATE_IDLE);
      gfx_rect(px + dx, py + i, pw - dx * 2, 1);
      i += 1;
    );
  );
);

function runtime_faceplate_draw_literal(x, y, w, h, r, top_r, top_g, top_b, top_a, bot_r, bot_g, bot_b, bot_a)
