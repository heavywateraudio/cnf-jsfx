  tmp[11] = inner_ring_a_a;
  tmp[12] = inner_ring_b_r;
  tmp[13] = inner_ring_b_g;
  tmp[14] = inner_ring_b_b;
  tmp[15] = inner_ring_b_a;
  tmp[16] = inner_fill_a_r;
  tmp[17] = inner_fill_a_g;
  tmp[18] = inner_fill_a_b;
  tmp[19] = inner_fill_a_a;
  tmp[20] = inner_fill_b_r;
  tmp[21] = inner_fill_b_g;
  tmp[22] = inner_fill_b_b;
  tmp[23] = inner_fill_b_a;
  tmp[24] = outer_fill_a_r;
  tmp[25] = outer_fill_a_g;
  tmp[26] = outer_fill_a_b;
  tmp[27] = outer_fill_a_a;
  tmp[28] = outer_fill_b_r;
  tmp[29] = outer_fill_b_g;
  tmp[30] = outer_fill_b_b;
  tmp[31] = outer_fill_b_a;
  tmp[32] = pointer_dot;
  tmp[33] = pointer_distance;
);

function runtime_knob_draw_literal(x, y, w, h, ring_px, pointer_px, pointer_len, value_px, frac, hover, str, ring_r, ring_g, ring_b, ring_a, hover_r, hover_g, hover_b, hover_a, pointer_r, pointer_g, pointer_b, pointer_a, inner_inset, inner_ring_px, show_inner_ring, show_inner_fill, show_outer_fill, negative_r, negative_g, negative_b, negative_a, positive_r, positive_g, positive_b, positive_a, label_text_r, label_text_g, label_text_b, label_text_a)
  local(tmp, px, py, pw, ph, pd, cx, cy, ro, rt, r_outer, inset_px, inner_rt,
        r_inner, r_inner_in, fill_cx, fill_cy, pl, hw, f, ang, ux, uy, nx, ny, r, n, t,
        row_start, row_end, row_count, row_i, row_y, sy, ho0, ho1, ho2, ho3,
        hi0, hi1, hi2, hi3, homax, homin, himax, ba, px_x, px_e, s0, s1, s2,
        s3, cov, tw, th, rr, rg, rb, ra, start_x, start_y, min_x, max_x, min_y, max_y,
        sample_x, sample_y, sample_i, sample_j, proj_u, proj_v, half_u, half_v,
        tr, tg, tb, ta, sx, m, dot, r_end, eu)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  (pw > 0 && ph > 0) ? (
    pd = min(pw, ph);
    cx = px + pw * 0.5;
    cy = py + ph * 0.5;
    fill_cx = floor(cx + 0.5) + 0.5;
    fill_cy = floor(cy + 0.5) + 0.5;
    ro = pd * 0.5;
    rt = floor(runtime_s(ring_px));
    r_outer = ro - rt;
    inset_px = floor(runtime_s(inner_inset));
    inner_rt = floor(runtime_s(inner_ring_px));
    r_inner = r_outer - inset_px;
    r_inner_in = r_inner - inner_rt;
    pl = floor(runtime_s(pointer_len));
    hw = floor(runtime_s(pointer_px)) * 0.5;
    f = min(max(frac, 0), 1);
    tmp = RUNTIME_ARENA_BASE + RUNTIME_TEMP_OFF;
    rr = hover ? hover_r : ring_r;
    rg = hover ? hover_g : ring_g;
    rb = hover ? hover_b : ring_b;
    ra = hover ? hover_a : ring_a;

    (rt > 0 && r_outer >= 0) ? (
      row_start = floor(fill_cy - ro - 1);
      row_count = ceil(fill_cy + ro + 1) - row_start;
      row_i = 0;
      loop(row_count,
        row_y = row_start + row_i;
        sy = row_y + 0.5 - fill_cy;
        ho0 = sqrt(max(0, (ro + 0.5) * (ro + 0.5) - sy * sy));
        hi0 = max(0, r_outer - 0.5);
        hi0 = sqrt(max(0, hi0 * hi0 - sy * sy));
        ho1 = floor(fill_cx - ho0); hi1 = ceil(fill_cx - hi0);
        n = 0;
        loop(2,
          sx = n == 0 ? ho1 : max(hi1, floor(fill_cx + hi0));
          loop(max(0, (n == 0 ? hi1 : ceil(fill_cx + ho0)) - sx),
            r = sqrt((sx + 0.5 - fill_cx) * (sx + 0.5 - fill_cx) + sy * sy);
            cov = min(ro, r + 0.5) - max(r_outer, r - 0.5);
            cov > 0 ? (
              t = (min(ro, max(r_outer, r)) - r_outer) / rt;
              runtime_color_literal(rr, rg, rb, ra, hover ? tmp[4] : tmp[0],
                                    hover ? tmp[5] : tmp[1],
                                    hover ? tmp[6] : tmp[2],
                                    hover ? tmp[7] : tmp[3], t, RUNTIME_STATE_IDLE);
              gfx_a *= min(1, cov);
              gfx_rect(sx, row_y, 1, 1);
            );
            sx += 1;
          );
          n += 1;
        );
        row_i += 1;
      );
    );

    (show_outer_fill != 0 && r_inner >= 0 && r_outer > r_inner && r_outer > 0) ? (
      row_start = floor(fill_cy - r_outer);
      row_end = ceil(fill_cy + r_outer);
      row_count = row_end - row_start;
      row_i = 0;
      loop(row_count,
        row_y = row_start + row_i;
        t = row_count > 1 ? row_i / (row_count - 1) : 0;
        runtime_color_literal(tmp[24], tmp[25], tmp[26], tmp[27],
                              tmp[28], tmp[29], tmp[30], tmp[31],
                              t, RUNTIME_STATE_IDLE);
        sy = row_y + 0.125 - fill_cy;
        ho0 = abs(sy) < r_outer ? sqrt(r_outer * r_outer - sy * sy) : 0;
        hi0 = abs(sy) < r_inner ? sqrt(r_inner * r_inner - sy * sy) : 0;
        sy = row_y + 0.375 - fill_cy;
        ho1 = abs(sy) < r_outer ? sqrt(r_outer * r_outer - sy * sy) : 0;
        hi1 = abs(sy) < r_inner ? sqrt(r_inner * r_inner - sy * sy) : 0;
        sy = row_y + 0.625 - fill_cy;
        ho2 = abs(sy) < r_outer ? sqrt(r_outer * r_outer - sy * sy) : 0;
        hi2 = abs(sy) < r_inner ? sqrt(r_inner * r_inner - sy * sy) : 0;
        sy = row_y + 0.875 - fill_cy;
        ho3 = abs(sy) < r_outer ? sqrt(r_outer * r_outer - sy * sy) : 0;
        hi3 = abs(sy) < r_inner ? sqrt(r_inner * r_inner - sy * sy) : 0;
        homax = max(max(ho0, ho1), max(ho2, ho3));
        homin = min(min(ho0, ho1), min(ho2, ho3));
        himax = max(max(hi0, hi1), max(hi2, hi3));
        homax > 0 ? (
          ba = gfx_a;
          px_x = floor(fill_cx - homax);
          px_e = ceil(fill_cx + homax);
          s0 = ceil(fill_cx - homin);
          s1 = floor(fill_cx - himax);
          s2 = ceil(fill_cx + himax);
          s3 = floor(fill_cx + homin);
          while (px_x < px_e) (
            px_x >= s0 && px_x < s1 ? (
              gfx_a = ba;
              gfx_rect(px_x, row_y, s1 - px_x, 1);
              px_x = s1;
            ) : px_x >= s2 && px_x < s3 ? (
              gfx_a = ba;
              gfx_rect(px_x, row_y, s3 - px_x, 1);
              px_x = s3;
            ) : (
              cov = 0.25 * (
                max(0, min(px_x + 1, fill_cx - hi0) - max(px_x, fill_cx - ho0)) + max(0, min(px_x + 1, fill_cx + ho0) - max(px_x, fill_cx + hi0)) +
                max(0, min(px_x + 1, fill_cx - hi1) - max(px_x, fill_cx - ho1)) + max(0, min(px_x + 1, fill_cx + ho1) - max(px_x, fill_cx + hi1)) +
                max(0, min(px_x + 1, fill_cx - hi2) - max(px_x, fill_cx - ho2)) + max(0, min(px_x + 1, fill_cx + ho2) - max(px_x, fill_cx + hi2)) +
                max(0, min(px_x + 1, fill_cx - hi3) - max(px_x, fill_cx - ho3)) + max(0, min(px_x + 1, fill_cx + ho3) - max(px_x, fill_cx + hi3)));
              cov > 0 ? (
                gfx_a = ba * min(cov, 1);
                gfx_rect(px_x, row_y, 1, 1);
              );
              px_x += 1;
            );
          );
          gfx_a = ba;
        );
        row_i += 1;
      );
    );

    (show_inner_ring != 0 && inner_rt > 0 && r_inner_in >= 0) ? (
      row_start = floor(fill_cy - r_inner - 1);
      row_count = ceil(fill_cy + r_inner + 1) - row_start;
      row_i = 0;
      loop(row_count,
        row_y = row_start + row_i;
        sy = row_y + 0.5 - fill_cy;
        ho0 = sqrt(max(0, (r_inner + 0.5) * (r_inner + 0.5) - sy * sy));
        hi0 = max(0, r_inner_in - 0.5);
        hi0 = sqrt(max(0, hi0 * hi0 - sy * sy));
        ho1 = floor(fill_cx - ho0); hi1 = ceil(fill_cx - hi0);
        n = 0;
        loop(2,
          sx = n == 0 ? ho1 : max(hi1, floor(fill_cx + hi0));
          loop(max(0, (n == 0 ? hi1 : ceil(fill_cx + ho0)) - sx),
            r = sqrt((sx + 0.5 - fill_cx) * (sx + 0.5 - fill_cx) + sy * sy);
            cov = min(r_inner, r + 0.5) - max(r_inner_in, r - 0.5);
            cov > 0 ? (
              t = (min(r_inner, max(r_inner_in, r)) - r_inner_in) / inner_rt;
              runtime_color_literal(tmp[8], tmp[9], tmp[10], tmp[11],
                                    tmp[12], tmp[13], tmp[14], tmp[15],
                                    t, RUNTIME_STATE_IDLE);
              gfx_a *= min(1, cov);
              gfx_rect(sx, row_y, 1, 1);
            );
            sx += 1;
          );
          n += 1;
        );
        row_i += 1;
      );
    );

    (show_inner_fill != 0 && r_inner_in > 0) ? (
      row_start = floor(fill_cy - r_inner_in);
      row_end = ceil(fill_cy + r_inner_in);
      row_count = row_end - row_start;
      row_i = 0;
      loop(row_count,
        row_y = row_start + row_i;
        t = row_count > 1 ? row_i / (row_count - 1) : 0;
        runtime_color_literal(tmp[16], tmp[17], tmp[18], tmp[19],
                              tmp[20], tmp[21], tmp[22], tmp[23],
                              t, RUNTIME_STATE_IDLE);
        sy = row_y + 0.125 - fill_cy;
        ho0 = abs(sy) < r_inner_in ? sqrt(r_inner_in * r_inner_in - sy * sy) : 0;
        hi0 = abs(sy) < 0 ? sqrt(0 * 0 - sy * sy) : 0;
        sy = row_y + 0.375 - fill_cy;
        ho1 = abs(sy) < r_inner_in ? sqrt(r_inner_in * r_inner_in - sy * sy) : 0;
        hi1 = abs(sy) < 0 ? sqrt(0 * 0 - sy * sy) : 0;
        sy = row_y + 0.625 - fill_cy;
        ho2 = abs(sy) < r_inner_in ? sqrt(r_inner_in * r_inner_in - sy * sy) : 0;
        hi2 = abs(sy) < 0 ? sqrt(0 * 0 - sy * sy) : 0;
        sy = row_y + 0.875 - fill_cy;
        ho3 = abs(sy) < r_inner_in ? sqrt(r_inner_in * r_inner_in - sy * sy) : 0;
        hi3 = abs(sy) < 0 ? sqrt(0 * 0 - sy * sy) : 0;
        homax = max(max(ho0, ho1), max(ho2, ho3));
        homin = min(min(ho0, ho1), min(ho2, ho3));
        himax = max(max(hi0, hi1), max(hi2, hi3));
        homax > 0 ? (
          ba = gfx_a;
          px_x = floor(fill_cx - homax);
          px_e = ceil(fill_cx + homax);
          s0 = ceil(fill_cx - homin);
          s1 = floor(fill_cx - himax);
          s2 = ceil(fill_cx + himax);
          s3 = floor(fill_cx + homin);
          while (px_x < px_e) (
            px_x >= s0 && px_x < s1 ? (
              gfx_a = ba;
              gfx_rect(px_x, row_y, s1 - px_x, 1);
              px_x = s1;
            ) : px_x >= s2 && px_x < s3 ? (
              gfx_a = ba;
              gfx_rect(px_x, row_y, s3 - px_x, 1);
              px_x = s3;
            ) : (
              cov = 0.25 * (
                max(0, min(px_x + 1, fill_cx - hi0) - max(px_x, fill_cx - ho0)) + max(0, min(px_x + 1, fill_cx + ho0) - max(px_x, fill_cx + hi0)) +
                max(0, min(px_x + 1, fill_cx - hi1) - max(px_x, fill_cx - ho1)) + max(0, min(px_x + 1, fill_cx + ho1) - max(px_x, fill_cx + hi1)) +
                max(0, min(px_x + 1, fill_cx - hi2) - max(px_x, fill_cx - ho2)) + max(0, min(px_x + 1, fill_cx + ho2) - max(px_x, fill_cx + hi2)) +
                max(0, min(px_x + 1, fill_cx - hi3) - max(px_x, fill_cx - ho3)) + max(0, min(px_x + 1, fill_cx + ho3) - max(px_x, fill_cx + hi3)));
              cov > 0 ? (
                gfx_a = ba * min(cov, 1);
                gfx_rect(px_x, row_y, 1, 1);
              );
              px_x += 1;
            );
          );
          gfx_a = ba;
        );
        row_i += 1;
      );
    );

    dot = tmp[32] != 0;
    r_end = dot ? ro - floor(runtime_s(tmp[33])) : r_outer;
    (pl > 0 && hw >= 0.5 && (dot || r_outer - pl >= 0)) ? (
      runtime_color_literal(pointer_r, pointer_g, pointer_b, pointer_a,
                            pointer_r, pointer_g, pointer_b, pointer_a,
                            0, RUNTIME_STATE_IDLE);
      ang = f * 2 * $pi;
      ux = sin(ang);
      uy = -cos(ang);
      nx = uy;
      ny = -ux;
      start_x = cx + ux * (r_end - pl);
      start_y = cy + uy * (r_end - pl);
      min_x = min(start_x, cx + ux * r_end) - abs(nx) * hw;
      max_x = max(start_x, cx + ux * r_end) + abs(nx) * hw;
      min_y = min(start_y, cy + uy * r_end) - abs(ny) * hw;
      max_y = max(start_y, cy + uy * r_end) + abs(ny) * hw;
      half_u = (abs(ux) + abs(uy)) * 0.5;
      half_v = (abs(nx) + abs(ny)) * 0.5;
      row_start = floor(min_y);
      row_end = ceil(max_y);
      row_count = row_end - row_start;
      row_i = 0;
      ba = gfx_a;
      loop(row_count,
        row_y = row_start + row_i;
        px_x = floor(min_x);
        px_e = ceil(max_x);
        while (px_x < px_e) (
          sample_x = px_x + 0.5;
          sample_y = row_y + 0.5;
          proj_u = (sample_x - start_x) * ux + (sample_y - start_y) * uy;
          proj_v = (sample_x - start_x) * nx + (sample_y - start_y) * ny;
          (dot == 0 && proj_u - half_u >= 0 && proj_u + half_u <= pl &&
           proj_v - half_v >= -hw && proj_v + half_v <= hw) ? (
            cov = 1;
          ) : (
            (px_x + 1 <= min_x || px_x >= max_x || row_y + 1 <= min_y || row_y >= max_y ||
             proj_u + half_u <= 0 || proj_u - half_u >= pl ||
             proj_v + half_v <= -hw || proj_v - half_v >= hw) ? (
              cov = 0;
            ) : (
              cov = 0;
              sample_i = 0;
              loop(16,
                sample_j = 0;
                loop(16,
                  sample_x = px_x + (sample_i + 0.5) / 16;
                  sample_y = row_y + (sample_j + 0.5) / 16;
                  proj_u = (sample_x - start_x) * ux + (sample_y - start_y) * uy;
                  proj_v = (sample_x - start_x) * nx + (sample_y - start_y) * ny;
                  eu = (proj_u - pl * 0.5) / (pl * 0.5);
                  (dot ? (eu * eu + (proj_v / hw) * (proj_v / hw) <= 1) :
                   (proj_u >= 0 && proj_u <= pl && abs(proj_v) <= hw)) ? cov += 1;
                  sample_j += 1;
                );
                sample_i += 1;
              );
              cov /= 256;
            );
          );
          cov > 0 ? (
            gfx_a = ba * cov;
            gfx_rect(px_x, row_y, 1, 1);
          );
          px_x += 1;
        );
        row_i += 1;
      );
      gfx_a = ba;
    );

    strlen(str) > 0 ? (
      runtime_text_font_private(runtime_sf(value_px));
      m = runtime_text_ink_private(runtime_sf(value_px));
      gfx_measurestr(str, tw, th);
      gfx_x = floor(cx - tw * 0.5);
      gfx_y = floor(cy - m);
      tr = runtime_text_sign < 0 ? negative_r : (runtime_text_sign > 0 ? positive_r : label_text_r);
      tg = runtime_text_sign < 0 ? negative_g : (runtime_text_sign > 0 ? positive_g : label_text_g);
      tb = runtime_text_sign < 0 ? negative_b : (runtime_text_sign > 0 ? positive_b : label_text_b);
      ta = runtime_text_sign < 0 ? negative_a : (runtime_text_sign > 0 ? positive_a : label_text_a);
      runtime_color_literal(tr, tg, tb, ta, tr, tg, tb, ta, 0, RUNTIME_STATE_IDLE);
      runtime_text_draw_private(str, 0, 0);
    );
  );
  runtime_text_style(0, 0);
  runtime_text_sign = 0;
);

function runtime_label_draw(id, x, y, w, h, slot, font_px, str)
  local(px, py, pw, ph, tw, th)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  (pw > 0 && ph > 0 && strlen(str) > 0) ? (
    runtime_text_font_private(runtime_sf(font_px));
    gfx_measurestr(str, tw, th);
    tw = runtime_text_draw_private(str, 1, 1);
    gfx_x = px + floor((pw - tw) * 0.5);
    gfx_y = py + floor((ph - th) * 0.5);
    runtime_color_apply(id, slot, 0, RUNTIME_STATE_IDLE);
    runtime_text_draw_private(str, 0, 1);
  );
  runtime_text_style(0, 0);
);

function runtime_label_draw_literal(x, y, w, h, font_px, str, text_r, text_g, text_b, text_a)
  local(px, py, pw, ph, tw, th)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  (pw > 0 && ph > 0 && strlen(str) > 0) ? (
    runtime_text_font_private(runtime_sf(font_px));
    gfx_measurestr(str, tw, th);
    tw = runtime_text_draw_private(str, 1, 1);
    gfx_x = px + floor((pw - tw) * 0.5);
    gfx_y = py + floor((ph - th) * 0.5);
    runtime_color_literal(text_r, text_g, text_b, text_a, text_r, text_g, text_b, text_a, 0,
                         RUNTIME_STATE_IDLE);
    runtime_text_draw_private(str, 0, 1);
  );
  runtime_text_style(0, 0);
);

function runtime_numbox_addr_private(widget_id)
(
  RUNTIME_ARENA_BASE + RUNTIME_WIDGET_OFF + (widget_id - 1) * 8;
);

function runtime_numbox_decimals_private(vstep)
  local(d, i, s)
(
  vstep == 0 ? 2 : (
    d = 6;
    i = 6;
    loop(7,
      s = abs(vstep) * pow(10, i);
      abs(s - floor(s + 0.5)) <= 0.000000001 ? d = i;
      i -= 1;
    );
    d;
  );
);

function runtime_numbox_init(widget_id, value, enabled, flags, vmin, vmax, vstep)
  local(a)
(
  a = runtime_numbox_addr_private(widget_id);
  a[3] = vmin;
  a[4] = vmax;
  a[5] = vstep;
  a[6] = runtime_numbox_decimals_private(vstep);
  a[0] = min(max(value, vmin), vmax);
  a[1] = enabled != 0 ? 1 : 0;
  a[2] = flags;
  a[7] = -1;
);

function runtime_numbox_get(widget_id)
  local(a)
(
  a = runtime_numbox_addr_private(widget_id);
  a[0];
);

function runtime_numbox_set(widget_id, value)
  local(a)
(
  a = runtime_numbox_addr_private(widget_id);
  a[0] = min(max(value, a[3]), a[4]);
);

function runtime_numbox_format(widget_id, out)
  local(a, d, v)
(
  a = runtime_numbox_addr_private(widget_id);
  d = a[6];
  v = a[0];
  floor(abs(v) * pow(10, d) + 0.5) == 0 ? v = 0;
  runtime_text_sign = v < 0 ? -1 : (v > 0 ? 1 : 0);
  d == 0 ? sprintf(out, "%.0f", v) :
  d == 1 ? sprintf(out, "%.1f", v) :
  d == 2 ? sprintf(out, "%.2f", v) :
  d == 3 ? sprintf(out, "%.3f", v) :
  d == 4 ? sprintf(out, "%.4f", v) :
  d == 5 ? sprintf(out, "%.5f", v) :
           sprintf(out, "%.6f", v);
  d;
);

function runtime_numbox_format_text(widget_id, out, decimals, flags, unit, below)
  local(a, d, v, m, r, fmt)
(
  a = runtime_numbox_addr_private(widget_id);
  v = a[0];
  d = decimals >= 0 ? decimals : a[6];
  runtime_text_sign = v < 0 ? -1 : (v > 0 ? 1 : 0);
  (v == a[3] && strlen(below) > 0) ? (
    strcpy(out, below);
  ) : (
    m = abs(v);
    ((flags & 2) && m >= 1000) ? (
      r = m >= 1000000 ? floor(m / 100000 + 0.5) : floor(m / 100 + 0.5);
      r = (v < 0 ? -r : r) / 10;
      fmt = (r == floor(r)) ? (((flags & 1) && r > 0) ? "%+.0f" : "%.0f")
                            : (((flags & 1) && r > 0) ? "%+.1f" : "%.1f");
      sprintf(out, fmt, r);
      strcat(out, m >= 1000000 ? "M" : "k");
    ) : (
      floor(m * pow(10, d) + 0.5) == 0 ? (v = 0; runtime_text_sign = 0;);
      fmt = ((flags & 1) && v > 0) ? (
        d == 0 ? "%+.0f" : (d == 1 ? "%+.1f" : (d == 2 ? "%+.2f" : (d == 3 ? "%+.3f" :
        (d == 4 ? "%+.4f" : (d == 5 ? "%+.5f" : "%+.6f")))))
      ) : (
        d == 0 ? "%.0f" : (d == 1 ? "%.1f" : (d == 2 ? "%.2f" : (d == 3 ? "%.3f" :
        (d == 4 ? "%.4f" : (d == 5 ? "%.5f" : "%.6f")))))
      );
      sprintf(out, fmt, v);
    );
    strlen(unit) > 0 ? (
      strcmp(unit, "%") == 0 ? strcat(out, unit) : (strcat(out, " "); strcat(out, unit););
    );
  );
  d;
);

function runtime_numbox_mouse(widget_id, owner_id, my, anchor_y, anchor_v)
  local(a, v0, v1)
(
  a = runtime_numbox_addr_private(widget_id);
  v0 = a[0];
  v1 = v0;
  (a[1] != 0 && owner_id == widget_id) ? (
    v1 = anchor_v + (anchor_y - my) / runtime_s(runtime_drag_throw) * (a[4] - a[3]);
    v1 = min(max(v1, a[3]), a[4]);
  );
  a[0] = v1;
  v1 != v0;
);

function runtime_numbox_reset(widget_id, owner_id, mx, my, x, y, w, h, trigger)
  local(a, v0)
(
  a = runtime_numbox_addr_private(widget_id);
  v0 = a[0];
  (trigger == 1 && owner_id == 0 && a[1] != 0 &&
   runtime_hit(mx, my, x, y, w, h)) ? (
    a[0] = a[3];
  );
  a[0] != v0;
);

function runtime_numbox_reset_to(widget_id, owner_id, mx, my, x, y, w, h, trigger, value)
  local(a, v0)
(
  a = runtime_numbox_addr_private(widget_id);
  v0 = a[0];
  (trigger == 1 && owner_id == 0 && a[1] != 0 &&
   runtime_hit(mx, my, x, y, w, h)) ? (
    a[0] = min(max(value, a[3]), a[4]);
  );
  a[0] != v0;
);

function runtime_numbox_draw(id, x, y, w, h, radius, caret_px, value_px, editing, str)
  local(px, py, pw, ph, pr, cx, cy, sx, tw, th, cw, ch, s_fill, s_text, m)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  pr = floor(runtime_s(radius));
  (pw > 0 && ph > 0) ? (
    cx = px + pw * 0.5;
    cy = py + ph * 0.5;
    sx = floor(cx);
    tw = 0;
    s_fill = editing ? RUNTIME_SLOT_NUMBOX_EDIT_FILL : RUNTIME_SLOT_NUMBOX_FILL;
    s_text = editing ? RUNTIME_SLOT_NUMBOX_EDIT_TEXT :
             (runtime_text_sign < 0 ? RUNTIME_SLOT_NUMBOX_NEGATIVE :
             (runtime_text_sign > 0 ? RUNTIME_SLOT_NUMBOX_POSITIVE : RUNTIME_SLOT_NUMBOX_TEXT));
    runtime_color_apply(id, s_fill, 0, RUNTIME_STATE_IDLE);
    runtime_rr_fill(px, py, pw, ph, pr);
    m = 0;
    strlen(str) > 0 ? (
      runtime_text_font_private(runtime_sf(value_px));
      m = runtime_text_ink_private(runtime_sf(value_px));
      gfx_measurestr(str, tw, th);
      sx = floor(cx - tw * 0.5);
      gfx_x = sx;
      gfx_y = floor(cy - m);
      runtime_color_apply(id, s_text, 0, RUNTIME_STATE_IDLE);
      runtime_text_draw_private(str, 0, 0);
    );
    editing ? (
      cw = floor(runtime_s(caret_px));
      ch = runtime_sf(value_px);
      (cw > 0 && ch > 0) ? (
        runtime_color_apply(id, RUNTIME_SLOT_NUMBOX_ACCENT, 0, RUNTIME_STATE_IDLE);
        gfx_rect(sx + tw, floor(floor(cy - m) + m - ch * 0.5), cw, ch);
      );
    );
  );
  runtime_text_style(0, 0);
  runtime_text_sign = 0;
);

function runtime_numbox_draw_literal(x, y, w, h, radius, caret_px, value_px, editing, str, fill_r, fill_g, fill_b, fill_a, edit_fill_r, edit_fill_g, edit_fill_b, edit_fill_a, text_r, text_g, text_b, text_a, edit_text_r, edit_text_g, edit_text_b, edit_text_a, accent_r, accent_g, accent_b, accent_a, negative_r, negative_g, negative_b, negative_a, positive_r, positive_g, positive_b, positive_a)
  local(px, py, pw, ph, pr, cx, cy, sx, tw, th, cw, ch, fr, fg, fb, fa, tr, tg, tb, ta, m)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  pr = floor(runtime_s(radius));
  (pw > 0 && ph > 0) ? (
    cx = px + pw * 0.5;
    cy = py + ph * 0.5;
    sx = floor(cx);
    tw = 0;
    fr = editing ? edit_fill_r : fill_r;
    fg = editing ? edit_fill_g : fill_g;
    fb = editing ? edit_fill_b : fill_b;
    fa = editing ? edit_fill_a : fill_a;
    tr = editing ? edit_text_r : (runtime_text_sign < 0 ? negative_r : (runtime_text_sign > 0 ? positive_r : text_r));
    tg = editing ? edit_text_g : (runtime_text_sign < 0 ? negative_g : (runtime_text_sign > 0 ? positive_g : text_g));
    tb = editing ? edit_text_b : (runtime_text_sign < 0 ? negative_b : (runtime_text_sign > 0 ? positive_b : text_b));
    ta = editing ? edit_text_a : (runtime_text_sign < 0 ? negative_a : (runtime_text_sign > 0 ? positive_a : text_a));
    runtime_color_literal(fr, fg, fb, fa, fr, fg, fb, fa, 0, RUNTIME_STATE_IDLE);
    runtime_rr_fill(px, py, pw, ph, pr);
    m = 0;
    strlen(str) > 0 ? (
      runtime_text_font_private(runtime_sf(value_px));
      m = runtime_text_ink_private(runtime_sf(value_px));
      gfx_measurestr(str, tw, th);
      sx = floor(cx - tw * 0.5);
      gfx_x = sx;
      gfx_y = floor(cy - m);
      runtime_color_literal(tr, tg, tb, ta, tr, tg, tb, ta, 0, RUNTIME_STATE_IDLE);
      runtime_text_draw_private(str, 0, 0);
    );
    editing ? (
      cw = floor(runtime_s(caret_px));
      ch = runtime_sf(value_px);
      (cw > 0 && ch > 0) ? (
        runtime_color_literal(accent_r, accent_g, accent_b, accent_a, accent_r, accent_g, accent_b, accent_a, 0, RUNTIME_STATE_IDLE);
        gfx_rect(sx + tw, floor(floor(cy - m) + m - ch * 0.5), cw, ch);
      );
    );
  );
  runtime_text_style(0, 0);
  runtime_text_sign = 0;
);

function runtime_meter_span_private(id, slot, x, y, w, h, px, py, pw, ph, f0, f1, direction)
  local(e0, e1, rx, ry, rw, rh)
(
  f1 > f0 ? (
    direction == 0 ? (
      e0 = floor(runtime_y(y + h - f0 * h));
      e1 = floor(runtime_y(y + h - f1 * h));
      e0 = min(py + ph, max(py, e0));
      e1 = min(py + ph, max(py, e1));
      rx = px;
      ry = e1;
      rw = pw;
      rh = e0 - e1;
    ) : direction == 1 ? (
      e0 = floor(runtime_x(x + f0 * w));
      e1 = floor(runtime_x(x + f1 * w));
      e0 = min(px + pw, max(px, e0));
      e1 = min(px + pw, max(px, e1));
      rx = e0;
      ry = py;
      rw = e1 - e0;
      rh = ph;
    ) : direction == 2 ? (
      e0 = floor(runtime_y(y + f0 * h));
      e1 = floor(runtime_y(y + f1 * h));
      e0 = min(py + ph, max(py, e0));
      e1 = min(py + ph, max(py, e1));
      rx = px;
      ry = e0;
      rw = pw;
      rh = e1 - e0;
    ) : (
      e0 = floor(runtime_x(x + w - f0 * w));
      e1 = floor(runtime_x(x + w - f1 * w));
      e0 = min(px + pw, max(px, e0));
      e1 = min(px + pw, max(px, e1));
      rx = e1;
      ry = py;
      rw = e0 - e1;
      rh = ph;
    );
    (rw > 0 && rh > 0) ? (
      runtime_color_apply(id, slot, 0, RUNTIME_STATE_IDLE);
      gfx_rect(rx, ry, rw, rh);
    );
  );
);

function runtime_meter_span_literal_private(x, y, w, h, px, py, pw, ph, f0, f1, direction, red, green, blue, alpha)
  local(e0, e1, rx, ry, rw, rh)
(
  f1 > f0 ? (
    direction == 0 ? (
      e0 = floor(runtime_y(y + h - f0 * h));
      e1 = floor(runtime_y(y + h - f1 * h));
      e0 = min(py + ph, max(py, e0));
      e1 = min(py + ph, max(py, e1));
      rx = px;
      ry = e1;
      rw = pw;
      rh = e0 - e1;
    ) : direction == 1 ? (
      e0 = floor(runtime_x(x + f0 * w));
      e1 = floor(runtime_x(x + f1 * w));
      e0 = min(px + pw, max(px, e0));
      e1 = min(px + pw, max(px, e1));
      rx = e0;
      ry = py;
      rw = e1 - e0;
      rh = ph;
    ) : direction == 2 ? (
      e0 = floor(runtime_y(y + f0 * h));
      e1 = floor(runtime_y(y + f1 * h));
      e0 = min(py + ph, max(py, e0));
      e1 = min(py + ph, max(py, e1));
      rx = px;
      ry = e0;
      rw = pw;
      rh = e1 - e0;
    ) : (
      e0 = floor(runtime_x(x + w - f0 * w));
      e1 = floor(runtime_x(x + w - f1 * w));
      e0 = min(px + pw, max(px, e0));
      e1 = min(px + pw, max(px, e1));
      rx = e1;
      ry = py;
      rw = e0 - e1;
      rh = ph;
    );
    (rw > 0 && rh > 0) ? (
      runtime_color_literal(red, green, blue, alpha, red, green, blue, alpha, 0,
                            RUNTIME_STATE_IDLE);
      gfx_rect(rx, ry, rw, rh);
    );
  );
);

function runtime_meter_draw(id, x, y, w, h, level, scale_min, scale_max, direction, zone2_on, zone2_start, zone3_on, zone3_start)
  local(px, py, pw, ph, scale_range, fraction, zone2_fraction, zone3_fraction,
        zone2_enabled, zone3_enabled, zone2_end, zone1_end)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  (pw > 0 && ph > 0 && scale_max > scale_min) ? (
    scale_range = scale_max - scale_min;
    fraction = min(1, max(0, (level - scale_min) / scale_range));
    zone2_fraction = min(1, max(0, (zone2_start - scale_min) / scale_range));
    zone3_fraction = min(1, max(0, (zone3_start - scale_min) / scale_range));
    zone2_enabled = zone2_on != 0;
    zone3_enabled = zone3_on != 0;
    zone2_end = zone3_enabled ? min(fraction, zone3_fraction) : fraction;
    zone1_end = zone2_enabled ? min(fraction, zone2_fraction) : fraction;
    zone1_end = zone3_enabled ? min(zone1_end, zone3_fraction) : zone1_end;
    zone3_enabled ? runtime_meter_span_private(id, RUNTIME_SLOT_METER_ZONE3, x, y, w, h, px, py, pw, ph, zone3_fraction, fraction, direction);
    zone2_enabled ? runtime_meter_span_private(id, RUNTIME_SLOT_METER_ZONE2, x, y, w, h, px, py, pw, ph, zone2_fraction, zone2_end, direction);
    runtime_meter_span_private(id, RUNTIME_SLOT_METER_ZONE1, x, y, w, h, px, py, pw, ph, 0, zone1_end, direction);
  );
);

function runtime_meter_draw_literal(x, y, w, h, level, scale_min, scale_max, direction, zone2_on, zone2_start, zone3_on, zone3_start, zone1_r, zone1_g, zone1_b, zone1_a, zone2_r, zone2_g, zone2_b, zone2_a, zone3_r, zone3_g, zone3_b, zone3_a)
  local(px, py, pw, ph, scale_range, fraction, zone2_fraction, zone3_fraction,
        zone2_enabled, zone3_enabled, zone2_end, zone1_end)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  (pw > 0 && ph > 0 && scale_max > scale_min) ? (
    scale_range = scale_max - scale_min;
    fraction = min(1, max(0, (level - scale_min) / scale_range));
    zone2_fraction = min(1, max(0, (zone2_start - scale_min) / scale_range));
    zone3_fraction = min(1, max(0, (zone3_start - scale_min) / scale_range));
    zone2_enabled = zone2_on != 0;
    zone3_enabled = zone3_on != 0;
    zone2_end = zone3_enabled ? min(fraction, zone3_fraction) : fraction;
    zone1_end = zone2_enabled ? min(fraction, zone2_fraction) : fraction;
    zone1_end = zone3_enabled ? min(zone1_end, zone3_fraction) : zone1_end;
    zone3_enabled ? runtime_meter_span_literal_private(x, y, w, h, px, py, pw, ph, zone3_fraction, fraction, direction, zone3_r, zone3_g, zone3_b, zone3_a);
    zone2_enabled ? runtime_meter_span_literal_private(x, y, w, h, px, py, pw, ph, zone2_fraction, zone2_end, direction, zone2_r, zone2_g, zone2_b, zone2_a);
    runtime_meter_span_literal_private(x, y, w, h, px, py, pw, ph, 0, zone1_end, direction, zone1_r, zone1_g, zone1_b, zone1_a);
  );
);

function runtime_meter_draw_from(id, x, y, w, h, level, scale_min, scale_max, direction, starts_at, zone2_on, zone2_start, zone3_on, zone3_start)
  local(px, py, pw, ph, scale_range, fraction, zone2_fraction, zone3_fraction,
        zone2_enabled, zone3_enabled, zone2_end, zone1_end)
(
  starts_at == 0 ? (
    runtime_meter_draw(id, x, y, w, h, level, scale_min, scale_max, direction, zone2_on, zone2_start, zone3_on, zone3_start);
  ) : (
    px = floor(runtime_x(x));
    py = floor(runtime_y(y));
    pw = floor(runtime_x(x + w)) - px;
    ph = floor(runtime_y(y + h)) - py;
    (pw > 0 && ph > 0 && scale_max > scale_min && level > -1000000) ? (
      scale_range = scale_max - scale_min;
      fraction = min(1, max(0, (level - scale_min) / scale_range));
      zone2_fraction = min(1, max(0, (zone2_start - scale_min) / scale_range));
      zone3_fraction = min(1, max(0, (zone3_start - scale_min) / scale_range));
      zone2_enabled = zone2_on != 0;
      zone3_enabled = zone3_on != 0;
      zone2_end = zone3_enabled ? max(fraction, zone3_fraction) : fraction;
      zone1_end = zone2_enabled ? max(fraction, zone2_fraction) : fraction;
      zone1_end = zone3_enabled ? max(zone1_end, zone3_fraction) : zone1_end;
      zone3_enabled ? runtime_meter_span_private(id, RUNTIME_SLOT_METER_ZONE3, x, y, w, h, px, py, pw, ph, 1 - zone3_fraction, 1 - fraction, direction);
      zone2_enabled ? runtime_meter_span_private(id, RUNTIME_SLOT_METER_ZONE2, x, y, w, h, px, py, pw, ph, 1 - zone2_fraction, 1 - zone2_end, direction);
      runtime_meter_span_private(id, RUNTIME_SLOT_METER_ZONE1, x, y, w, h, px, py, pw, ph, 0, 1 - zone1_end, direction);
    );
  );
);

function runtime_meter_draw_from_literal(x, y, w, h, level, scale_min, scale_max, direction, starts_at, zone2_on, zone2_start, zone3_on, zone3_start, zone1_r, zone1_g, zone1_b, zone1_a, zone2_r, zone2_g, zone2_b, zone2_a, zone3_r, zone3_g, zone3_b, zone3_a)
  local(px, py, pw, ph, scale_range, fraction, zone2_fraction, zone3_fraction,
        zone2_enabled, zone3_enabled, zone2_end, zone1_end)
(
  starts_at == 0 ? (
    runtime_meter_draw_literal(x, y, w, h, level, scale_min, scale_max, direction, zone2_on, zone2_start, zone3_on, zone3_start, zone1_r, zone1_g, zone1_b, zone1_a, zone2_r, zone2_g, zone2_b, zone2_a, zone3_r, zone3_g, zone3_b, zone3_a);
  ) : (
    px = floor(runtime_x(x));
    py = floor(runtime_y(y));
    pw = floor(runtime_x(x + w)) - px;
    ph = floor(runtime_y(y + h)) - py;
    (pw > 0 && ph > 0 && scale_max > scale_min && level > -1000000) ? (
      scale_range = scale_max - scale_min;
      fraction = min(1, max(0, (level - scale_min) / scale_range));
      zone2_fraction = min(1, max(0, (zone2_start - scale_min) / scale_range));
      zone3_fraction = min(1, max(0, (zone3_start - scale_min) / scale_range));
      zone2_enabled = zone2_on != 0;
      zone3_enabled = zone3_on != 0;
      zone2_end = zone3_enabled ? max(fraction, zone3_fraction) : fraction;
      zone1_end = zone2_enabled ? max(fraction, zone2_fraction) : fraction;
      zone1_end = zone3_enabled ? max(zone1_end, zone3_fraction) : zone1_end;
      zone3_enabled ? runtime_meter_span_literal_private(x, y, w, h, px, py, pw, ph, 1 - zone3_fraction, 1 - fraction, direction, zone3_r, zone3_g, zone3_b, zone3_a);
      zone2_enabled ? runtime_meter_span_literal_private(x, y, w, h, px, py, pw, ph, 1 - zone2_fraction, 1 - zone2_end, direction, zone2_r, zone2_g, zone2_b, zone2_a);
      runtime_meter_span_literal_private(x, y, w, h, px, py, pw, ph, 0, 1 - zone1_end, direction, zone1_r, zone1_g, zone1_b, zone1_a);
    );
  );
);

function runtime_meter_track_draw(id, x, y, w, h)
  local(px, py, pw, ph)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  (pw > 0 && ph > 0) ? (
    runtime_color_apply(id, RUNTIME_SLOT_METER_OFF, 0, RUNTIME_STATE_IDLE);
    gfx_rect(px, py, pw, ph);
  );
);

function runtime_meter_track_draw_literal(x, y, w, h, off_r, off_g, off_b, off_a)
  local(px, py, pw, ph)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  (pw > 0 && ph > 0) ? (
    runtime_color_literal(off_r, off_g, off_b, off_a, off_r, off_g, off_b, off_a, 0,
                          RUNTIME_STATE_IDLE);
    gfx_rect(px, py, pw, ph);
  );
);

function runtime_led_cover_private(col, row, half)
  local(n, i, j, dx, dy)
(
  n = 0;
  j = 0;
  loop(4,
    dy = row + (j + 0.5) / 4 - half;
    i = 0;
    loop(4,
      dx = col + (i + 0.5) / 4 - half;
      dx * dx + dy * dy < half * half ? n += 1;
      i += 1;
    );
    j += 1;
  );
  n / 16;
);

function runtime_led_fill_private(px, py, pw, ph, shape)
  local(d, sx, sy, half, base, row, y0, y1, ynear, yfar, win, wout, i0, i1, o0, o1, col, cov)
(
  shape == 1 ? (
    gfx_rect(px, py, pw, ph);
  ) : (
    d = min(pw, ph);
    sx = px + floor((pw - d) / 2);
    sy = py + floor((ph - d) / 2);
    half = d / 2;
    base = gfx_a;
    row = 0;
    loop(d,
      y0 = row - half;
      y1 = row + 1 - half;
      yfar = max(abs(y0), abs(y1));
      ynear = (y0 < 0 && y1 > 0) ? 0 : min(abs(y0), abs(y1));
      win = sqrt(max(0, half * half - yfar * yfar));
      wout = sqrt(max(0, half * half - ynear * ynear));
      i0 = ceil(half - win);
      i1 = floor(half + win);
      o0 = max(0, floor(half - wout));
      o1 = min(d, ceil(half + wout));
      i1 <= i0 ? (
        i0 = o1;
        i1 = o1;
      );
      gfx_a = base;
      i1 > i0 ? gfx_rect(sx + i0, sy + row, i1 - i0, 1);
      col = o0;
      loop(i0 - o0,
        cov = runtime_led_cover_private(col, row, half);
        cov > 0 ? (
          gfx_a = base * cov;
          gfx_rect(sx + col, sy + row, 1, 1);
        );
        col += 1;
      );
      col = i1;
      loop(o1 - i1,
        cov = runtime_led_cover_private(col, row, half);
        cov > 0 ? (
          gfx_a = base * cov;
          gfx_rect(sx + col, sy + row, 1, 1);
        );
        col += 1;
      );
      row += 1;
    );
    gfx_a = base;
  );
);

function runtime_led_draw(id, x, y, w, h, lit, shape)
  local(px, py, pw, ph)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  (pw > 0 && ph > 0) ? (
    runtime_color_apply(id, lit != 0 ? RUNTIME_SLOT_LED_ON : RUNTIME_SLOT_LED_OFF, 0, RUNTIME_STATE_IDLE);
    runtime_led_fill_private(px, py, pw, ph, shape);
  );
);

function runtime_led_draw_literal(x, y, w, h, lit, shape, on_r, on_g, on_b, on_a, off_r, off_g, off_b, off_a)
  local(px, py, pw, ph)
(
  px = floor(runtime_x(x));
  py = floor(runtime_y(y));
  pw = floor(runtime_x(x + w)) - px;
  ph = floor(runtime_y(y + h)) - py;
  (pw > 0 && ph > 0) ? (
    lit != 0 ? (
      runtime_color_literal(on_r, on_g, on_b, on_a, on_r, on_g, on_b, on_a, 0, RUNTIME_STATE_IDLE);
    ) : (
      runtime_color_literal(off_r, off_g, off_b, off_a, off_r, off_g, off_b, off_a, 0, RUNTIME_STATE_IDLE);
    );
    runtime_led_fill_private(px, py, pw, ph, shape);
  );
);
gfx_ext_retina = 1;
RUNTIME_ARENA_BASE = 8383488;
RUNTIME_GEOM_WIDTH = 0;
RUNTIME_WIDGET_WIDTH = 4096;
RUNTIME_COLOR_WIDTH = 0;
RUNTIME_TEMP_WIDTH = 1024;
RUNTIME_GEOM_OFF = 0;
RUNTIME_WIDGET_OFF = RUNTIME_GEOM_WIDTH;
RUNTIME_COLOR_OFF = RUNTIME_GEOM_WIDTH + RUNTIME_WIDGET_WIDTH;
RUNTIME_TEMP_OFF = RUNTIME_GEOM_WIDTH + RUNTIME_WIDGET_WIDTH + RUNTIME_COLOR_WIDTH;
RUNTIME_ARENA_WORDS = RUNTIME_GEOM_WIDTH + RUNTIME_WIDGET_WIDTH + RUNTIME_COLOR_WIDTH + RUNTIME_TEMP_WIDTH;
fl47bdb600_last_mouse_cap = 0;
RUNTIME_OWNER = 0;
fl47bdb600_drag_anchor_y = 0;
fl47bdb600_drag_anchor_v = 0;
fl47bdb600_gesture_last_id = 0;
fl47bdb600_gesture_last_t = 0;
fl47bdb600_mom_held = 0;
fl47bdb600_edit_owner = 0;
strcpy(#fl47bdb600_edit_buf, "");
fl47bdb600_key_c = 0;
fl47bdb600_key_ed = 0;
fl47bdb600_key_mom = 0;
fl47bdb600_key_v = 0;
function edit_has_digit_private(srcstr)
  local(n, i, c, r)
(
  n = strlen(srcstr);
  i = 0;
  r = 0;
  while (i < n) (
    c = str_getchar(srcstr, i);
    (c >= 48 && c <= 57) ? r = 1;
    i += 1;
  );
  r;
);
function edit_parse_private(srcstr)
  local(n, i, c, sign, ip, fp, fd, dot)
(
  n = strlen(srcstr);
  i = 0;
  sign = 1;
  ip = 0;
  fp = 0;
  fd = 1;
  dot = 0;
  while (i < n) (
    c = str_getchar(srcstr, i);
    (c == 45 && i == 0) ? sign = -1 :
    c == 46 ? dot = 1 :
    (c >= 48 && c <= 57) ? (
      dot ? (fd *= 10; fp += (c - 48) / fd;) : (ip = ip * 10 + (c - 48););
    );
    i += 1;
  );
  sign * (ip + fp);
);
fl47bdb600_last_slider2 = 0;
fl47bdb600_last_slider3 = 0;
fl47bdb600_last_slider1 = 0;
fl47bdb600_last_slider6 = 0;
runtime_knob_init(1, 0, 1, 1, 0, 50, 1);
runtime_button_init(2, 0, 1, 1, 0, 1, 1);
runtime_button_init_radio(3, 0, 1, 4, 0, 2, 1, 0);
runtime_button_init_radio(4, 0, 1, 4, 0, 2, 1, 1);
runtime_numbox_init(5, 0, 1, 1, 0, 50, 1);
runtime_button_init_radio(6, 0, 1, 4, 0, 2, 1, 2);
freembuf(RUNTIME_ARENA_BASE + RUNTIME_ARENA_WORDS);
// === FACELIFT END init ===
@slider
cnf_noise_level_db = floor(slider2 + 0.5);
cnf_noise_level_db < 0 ? cnf_noise_level_db = 0;
cnf_noise_level_db > 50 ? cnf_noise_level_db = 50;
cnf_bypass = slider3;
floor(slider1 + 0.5) < 2 ? follower_role = floor(slider1 + 0.5);

// === FACELIFT BEGIN sync v1 ===
RUNTIME_OWNER == 0 && slider2 != fl47bdb600_last_slider2 ? (runtime_knob_set(1, slider2); fl47bdb600_last_slider2 = slider2;);
RUNTIME_OWNER == 0 && slider3 != fl47bdb600_last_slider3 ? (runtime_button_set(2, slider3); fl47bdb600_last_slider3 = slider3;);
RUNTIME_OWNER == 0 && slider1 != fl47bdb600_last_slider1 ? (runtime_button_set(3, slider1););
RUNTIME_OWNER == 0 && slider1 != fl47bdb600_last_slider1 ? (runtime_button_set(4, slider1););
RUNTIME_OWNER == 0 && slider6 != fl47bdb600_last_slider6 ? (runtime_knob_set(1, slider6); fl47bdb600_last_slider6 = slider6;);
RUNTIME_OWNER == 0 && slider1 != fl47bdb600_last_slider1 ? (runtime_button_set(6, slider1); fl47bdb600_last_slider1 = slider1;);
// === FACELIFT END sync ===
@block
// === FACELIFT BEGIN slider_rerun v1 ===
fl47bdb600_slider_dirty ? (
fl47bdb600_slider_dirty = 0;
cnf_noise_level_db = floor(slider2 + 0.5);
cnf_noise_level_db < 0 ? cnf_noise_level_db = 0;
cnf_noise_level_db > 50 ? cnf_noise_level_db = 50;
cnf_bypass = slider3;
floor(slider1 + 0.5) < 2 ? follower_role = floor(slider1 + 0.5);

);
// === FACELIFT END slider_rerun ===
now = time_precise();

// --- internal role authority (the ONLY place topology is decided) ---
// The host-saved Role slider is the sole role request. Master is granted only
// when its shared claim is free, already ours, or stale.
role_request = floor(slider1 + 0.5);
role_request < 0 ? role_request = 0;
role_request > 2 ? role_request = 2;
role_request == 2 ? (
  ((gmem[6] == 0) || (gmem[6] == my_id) || ((now - gmem[7]) >= TIMEOUT)) ? (
    master_latch = 1;
  ) : (
    slider1 = master_latch ? 2 : follower_role;
    sliderchange(slider1);
  );
) : (
  master_latch = 0;
  (gmem[6] == my_id) ? gmem[6] = 0;
  follower_role = role_request;
);

i_hold_claim = (gmem[6] == my_id) && (my_id > 0) && ((now - gmem[7]) < TIMEOUT);
(i_hold_claim && slider1 == 2) ? ( master_latch = 1; );

master_role_locked = master_latch;
topology = master_role_locked ? 1 : (follower_role==1 ? 2 : 0);

// release slot + reset on role change (BOTH pools, so manual Channel<->Bus and ->Master
// switching cleanly releases whichever pool slot was held before claiming the new one).
topology != prev_topology ? (
  (held_slot>=1) ? (
    ho=CNF_BASE+(held_slot-1)*CNF_STRIDE; gmem[ho+12]=0; gmem[ho+0]=0; gmem[ho+1]=0; held_slot=0;
  );
  (bus_held_slot>=1) ? (
    bho=CNF_BUSROLE_BASE+(bus_held_slot-1)*CNF_STRIDE; gmem[bho+12]=0; gmem[bho+0]=0; gmem[bho+1]=0; bus_held_slot=0;
  );
  my_slot=0; claim_state=0; backoff_until=0;
  bus_my_slot=0; bus_claim_state=0; bus_backoff_until=0; bus_full_latched=0; bus_slots_full=0;
  prev_topology=topology;
);

abcomp_noise_rms = 0;

// =====================================================================
// LISTENING / TUNING BLOCK - INTERNAL EDITOR ONLY
// =====================================================================
// No sliders. No automation. No UI. No gmem exposure.
// Edit these constants in the code editor only.
// CNF_AUDITION_GAIN_DB MUST be 0 before any release build.
//
// HOW TO TUNE:
//   1. Set CNF_AUDITION_GAIN_DB = +12 or +18 to hear color and accumulation clearly.
//      Use +24 if needed in a loud mix. This scales CNF noise only - program audio untouched.
//   2. Tune spectral balance first: CNF_WHITE_MIX / CNF_PINK_MIX, CNF_HP_HZ, CNF_LP_HZ.
//      Listen for: hiss dominance, brown rumble, harsh 2-8 kHz, excessive top, noise wash.
//   3. Tune accumulation second: CNF_BUS_PER_CHANNEL_DB, CNF_BUILDUP.
//      Listen for: obvious level rise with track count vs. correct subtle load movement.
//   4. Tune product level last: CNF_PRODUCT_TRIM_DB and the floor dB constants.
//      Target: premium floor felt-not-heard during normal playback.
//   5. Return CNF_AUDITION_GAIN_DB = 0 before release testing. Ship at 0.
//
// SAFE RANGES:
//   CNF_AUDITION_GAIN_DB  : 0 for release. +6/+12/+18/+24 for temporary listening only.
//   CNF_PRODUCT_TRIM_DB   : 0 default. Suggested final trim range: -6..+6 dB.
//   CNF_WHITE_MIX         : suggested 0.15..0.45
//   CNF_PINK_MIX          : suggested 0.55..0.85  (blendnorm normalizes; need not sum to 1.0)
//   CNF_HP_HZ             : suggested 35..80
//   CNF_LP_HZ             : suggested 8000..14000
//   CNF_BUILDUP           : suggested 0.25..0.8
//   Floor dB constants    : adjust by ear; do not make normal playback consciously hissy.

CNF_AUDITION_GAIN_DB    = 0;      // !! MUST BE 0 FOR RELEASE !!  (+6/+12/+18/+24 to listen)
CNF_PRODUCT_TRIM_DB     = 0;      // final level trim for whole profile, dB  (-6..+6)

CNF_CH_FLOOR_DB         = -109;   // per-channel self-noise floor, dBFS
CNF_BUS_PER_CHANNEL_DB  = -118;   // per-channel contribution to shared bus floor, dBFS
CNF_BUS_AMP_DB          = -112;   // fixed bus amp floor, dBFS
CNF_OUT_AMP_DB          = -110;   // fixed output amp floor, dBFS

CNF_WHITE_MIX           = 0.30;   // white noise proportion  (0.15..0.45)
CNF_PINK_MIX            = 0.70;   // pink noise proportion   (0.55..0.85)
CNF_HP_HZ               = 48;     // high-pass frequency Hz  (35..80)
CNF_LP_HZ               = 11000;  // low-pass frequency Hz   (8000..14000)
CNF_BUILDUP             = 0.5;    // load-dependent accumulation scale  (0.25..0.8)

// ---------------------------------------------------------------------
// BUS-ROLE TUNING - INTERNAL EDITOR ONLY.
// Same rules as the block above: no sliders, no automation, no UI, no gmem/serialize
// leakage. These shape the BUS follower layer only (topology==2). They are namespaced
// CNF_BUSROLE_* to avoid confusion with CNF_BUS_PER_CHANNEL_DB / CNF_BUS_AMP_DB above,
// which belong to the MASTER internal summing model, NOT the Bus role.
//
// Bus = summing-bus / submix electronics floor, NOT louder Channel noise:
//   warmer & denser than Channel (more pink, less white);
//   smoother top (lower LP ~10.5 kHz, less sparkle);
//   strong sub/rumble suppression (higher HP ~55 Hz);
//   a subtle L/R-shared component (partly correlated, never mono);
//   a glacial input-activity density move (<= ~0.5 dB; "if uncertain, weaker").
// Levels are ear-tune starting points. The shared component slightly raises total
// RMS for a given nominal level; that is absorbed here via CNF_BUSROLE_LEVEL_DB /
// CNF_BUSROLE_PRODUCT_TRIM_DB (no hidden compensation elsewhere).
//
// SAFE RANGES:
//   CNF_BUSROLE_LEVEL_DB          : around -110..-104 (slightly above one Channel at -109,
//                                   far below the accumulated total Channel bed).
//   CNF_BUSROLE_WHITE_AMT         : suggested 0.10..0.25  (less than Channel's 0.30)
//   CNF_BUSROLE_PINK_AMT          : suggested 0.75..0.90
//   CNF_BUSROLE_SHARED_AMT        : suggested 0.20..0.45  (subtle; do NOT narrow the image)
//   CNF_BUSROLE_HP_HZ             : suggested 45..70
//   CNF_BUSROLE_LP_HZ             : suggested 9000..12000
//   CNF_BUSROLE_ACTIVITY_DEPTH_DB : 0.0..1.0 max movement (default 0.5)
//   CNF_BUSROLE_ACTIVITY_SMOOTH_SEC: 0.5..2.0 s (very slow; default 1.0)
//   CNF_BUSROLE_ACTIVITY_SENS     : env->0..1 sensitivity; higher = reaches full move sooner.
CNF_BUSROLE_LEVEL_DB           = -108;  // bus-role floor level, dBFS (ear-tune start)
CNF_BUSROLE_PRODUCT_TRIM_DB    = 0;     // bus-role level trim, dB (-6..+6)
CNF_BUSROLE_WHITE_AMT          = 0.18;  // less white than Channel -> less sparkle
CNF_BUSROLE_PINK_AMT           = 0.82;  // more pink -> warmer / denser
CNF_BUSROLE_SHARED_AMT         = 0.35;  // L/R-correlated component (subtle, not mono)
CNF_BUSROLE_HP_HZ              = 55;    // strong sub/rumble suppression
CNF_BUSROLE_LP_HZ              = 10500; // smoother top above ~10-12 kHz
CNF_BUSROLE_ACTIVITY_DEPTH_DB  = 0.5;   // max activity density move, dB (<= 1.0)
CNF_BUSROLE_ACTIVITY_SMOOTH_SEC= 1.0;   // activity envelope time constant, s (glacial)
CNF_BUSROLE_ACTIVITY_SENS      = 3.0;   // env(avg |in|)->0..1 mapping sensitivity

// A/B LEVEL COMPENSATION - INTERNAL MASTER-OWNED STATE.
// Fixed-reference energy compensation only. This is NOT AGC, not program-dependent,
// not a compressor/gate/expander, and it does not read program loudness. It estimates the
// known CNF-generated floor energy from active Channel/Bus counts + Master floor, then applies
// a bounded, smoothed Master output trim for fair On/Off comparison during normal playback.
CNF_ABCOMP_REFERENCE_DB = -18;  // 0 VU calibration reference for fixed energy matching
CNF_ABCOMP_MAX_CUT_DB   = 1.5;  // hard bound: compensation cannot become a hidden gain rider

// =====================================================================
// Active profile assignment — maps named constants to DSP variables.
// CNF_AUDITION_GAIN_DB = 0 is the release sound.
// Premium console floor:
//   pink-dominant shaped noise  -> mild warm low-mid density (no flat white hiss);
//   white minority under ~11 kHz roll-off -> restrained silky top, no obvious hiss;
//   HP ~48 Hz -> strong sub/rumble suppression (no brown rumble);
//   low busper + gentle buildup -> very low shared bus floor, controlled accumulation.
// =====================================================================
m_chfloor = CNF_CH_FLOOR_DB        + CNF_PRODUCT_TRIM_DB + CNF_AUDITION_GAIN_DB;
m_busper  = CNF_BUS_PER_CHANNEL_DB + CNF_PRODUCT_TRIM_DB + CNF_AUDITION_GAIN_DB;
m_busamp  = CNF_BUS_AMP_DB         + CNF_PRODUCT_TRIM_DB + CNF_AUDITION_GAIN_DB;
m_outamp  = CNF_OUT_AMP_DB         + CNF_PRODUCT_TRIM_DB + CNF_AUDITION_GAIN_DB;
m_white   = CNF_WHITE_MIX;
m_pink    = CNF_PINK_MIX;
m_hp      = CNF_HP_HZ;
m_lp      = CNF_LP_HZ;
m_buildup = CNF_BUILDUP;
m_lp = min(m_lp, srate*0.45);
ahp = 1 - exp(-2*$pi*m_hp/srate);
alp = 1 - exp(-2*$pi*m_lp/srate);
fL.ahp=ahp; fR.ahp=ahp; fL.alp=alp; fR.alp=alp;
wW=m_white; wP=m_pink; blendnorm = 1/sqrt(wW*wW + wP*wP);
// Folded blend constants, recomputed every block; runtime only.
kW = wW * blendnorm;
kP = wP * blendnorm * PINK_NORM;
// Folded white-noise SQRT3 constant, recomputed every block beside kW/kP; runtime only.
kW3 = kW * SQRT3;

// --- Bus-role derived values (block rate; cheap; used only when topology==2) ---
// CNF_AUDITION_GAIN_DB is included so the editor listening gain also scales the Bus layer.
m_busrole_level   = CNF_BUSROLE_LEVEL_DB + CNF_BUSROLE_PRODUCT_TRIM_DB + CNF_AUDITION_GAIN_DB;
busW              = CNF_BUSROLE_WHITE_AMT;
busP              = CNF_BUSROLE_PINK_AMT;
busShared         = CNF_BUSROLE_SHARED_AMT;
busblendnorm      = 1/sqrt(busW*busW + busP*busP);   // white/pink ratio normalize (as blendnorm)
// Bus folded blend constants, same rules as kW/kP above.
bus_kW            = busW * busblendnorm;
bus_kP            = busP * busblendnorm * PINK_NORM;
// Bus folded white-noise SQRT3 constant, same rules as kW3 above.
bus_kW3           = bus_kW * SQRT3;
bus_act_coef      = 1 - exp(-1/(srate*CNF_BUSROLE_ACTIVITY_SMOOTH_SEC));
bus_act_depth_lin = db2lin(CNF_BUSROLE_ACTIVITY_DEPTH_DB);
m_busrole_lp      = min(CNF_BUSROLE_LP_HZ, srate*0.45);
// Override the L/R shaper coefficients for the Bus role only. topology is exclusive and
// these are recomputed every block, so switching roles re-derives the correct shaping.
topology==2 ? (
  bahp = 1 - exp(-2*$pi*CNF_BUSROLE_HP_HZ/srate);
  balp = 1 - exp(-2*$pi*m_busrole_lp/srate);
  fL.ahp=bahp; fR.ahp=bahp; fL.alp=balp; fR.alp=balp;
);

topology==0 ? (
  // ================= CHANNEL (headless follower) =================
  // ---- auto-slot protocol ----
  claim_state==2 ? (
    oo=CNF_BASE+(my_slot-1)*CNF_STRIDE;
    gmem[oo+12]==my_id ? ( 0 ) : ( claim_state=0; my_slot=0; );  // lost -> reclaim
  ) : claim_state==1 ? (
    (now-claim_time) >= SETTLE ? (
      oo=CNF_BASE+(my_slot-1)*CNF_STRIDE;
      gmem[oo+12]==my_id ? ( claim_state=2; )
      : ( claim_state=0; my_slot=0; backoff_until = now + 0.01 + (my_id - floor(my_id/17)*17)*0.003; );
    );
  ) : (
    now >= backoff_until ? (
      start = my_id - floor(my_id/CNF_MAX_SLOTS)*CNF_MAX_SLOTS;
      found=0; k=0; occ=0;
      loop(CNF_MAX_SLOTS,
        cand = start + k; cand >= CNF_MAX_SLOTS ? cand -= CNF_MAX_SLOTS;
        sidx = cand + 1; so = CNF_BASE + (sidx-1)*CNF_STRIDE;
        isfree = (gmem[so+12]==0 || (now - gmem[so+0]) >= TIMEOUT);
        isfree==0 ? occ += 1;
        (found==0 && isfree) ? (
          (held_slot>=1 && held_slot!=sidx) ? ( ho=CNF_BASE+(held_slot-1)*CNF_STRIDE; gmem[ho+12]=0; gmem[ho+0]=0; gmem[ho+1]=0; );
          gmem[so+12]=my_id; gmem[so+0]=now; gmem[so+1]=1; gmem[so+3]=0;
          my_slot=sidx; held_slot=sidx; claim_state=1; claim_time=now; found=1;
        );
        k += 1;
      );
      slots_used = occ;
      slots_full = (found==0) ? 1 : 0;
    );
  );

  // refresh ownership of the held/owned slot
  (claim_state==2 && my_slot>=1) ? (
    slots_full = 0;
    (held_slot>=1 && held_slot!=my_slot) ? ( ho=CNF_BASE+(held_slot-1)*CNF_STRIDE; gmem[ho+12]=0; gmem[ho+0]=0; gmem[ho+1]=0; );
    oo=CNF_BASE+(my_slot-1)*CNF_STRIDE;
    gmem[oo+12]=my_id; gmem[oo+0]=now; gmem[oo+1]=1; gmem[oo+2]=0; gmem[oo+3]=0;
    gmem[oo+13]=CNF_VERSION; gmem[oo+14] = 0;
    held_slot=my_slot;
  );

  master_present = (now - gmem[4]) < TIMEOUT;
  mi = gmem[2];
  emit = (claim_state==2) && master_present && (mi>0);
  tgt_rms = emit ? db2lin(m_chfloor) * mi : 0;   // follows Master on/off (fixed profile)
) : topology==2 ? (
  // ================= BUS (summing-bus follower) =================
  // Separate 8-slot pool (CNF_BUSROLE_BASE). Follower only: silent without a live Master,
  // follows Master Noise Floor On/Off via gmem[2], publishes NO global authority state.
  // Same three-state claim protocol as Channel, on the Bus pool.
  bus_full_latched ? (
    // Over-capacity Bus is a latched inactive state. Do not retry silently when a
    // slot is later freed; user must leave Bus mode and select Bus again to clear the latch.
    bus_slots_full=1; bus_claim_state=0; bus_my_slot=0; bus_base_rms=0;
  ) : (
    bus_claim_state==2 ? (
      boo=CNF_BUSROLE_BASE+(bus_my_slot-1)*CNF_STRIDE;
      gmem[boo+12]==my_id ? ( 0 ) : ( bus_claim_state=0; bus_my_slot=0; );  // lost -> reclaim
    ) : bus_claim_state==1 ? (
      (now-bus_claim_time) >= SETTLE ? (
        boo=CNF_BUSROLE_BASE+(bus_my_slot-1)*CNF_STRIDE;
        gmem[boo+12]==my_id ? ( bus_claim_state=2; )
        : ( bus_claim_state=0; bus_my_slot=0; bus_backoff_until = now + 0.01 + (my_id - floor(my_id/17)*17)*0.003; );
      );
    ) : (
      now >= bus_backoff_until ? (
        // First free-slot scan still prefers the LOWEST free Bus slot, but if all
        // 8 slots are occupied the failure latches BUS FULL instead of polling forever.
        bstart = 0;
        bfound=0; bk=0;
        loop(CNF_BUSROLE_SLOTS,
          bcand = bstart + bk; bcand >= CNF_BUSROLE_SLOTS ? bcand -= CNF_BUSROLE_SLOTS;
          bsidx = bcand + 1; bso = CNF_BUSROLE_BASE + (bsidx-1)*CNF_STRIDE;
          bisfree = (gmem[bso+12]==0 || (now - gmem[bso+0]) >= TIMEOUT);
          (bfound==0 && bisfree) ? (
            (bus_held_slot>=1 && bus_held_slot!=bsidx) ? ( bho=CNF_BUSROLE_BASE+(bus_held_slot-1)*CNF_STRIDE; gmem[bho+12]=0; gmem[bho+0]=0; gmem[bho+1]=0; );
            gmem[bso+12]=my_id; gmem[bso+0]=now; gmem[bso+1]=1; gmem[bso+3]=0;
            bus_my_slot=bsidx; bus_held_slot=bsidx; bus_claim_state=1; bus_claim_time=now; bfound=1;
          );
          bk += 1;
        );
        bfound==0 ? (
          bus_slots_full=1; bus_full_latched=1; bus_claim_state=0; bus_my_slot=0; bus_held_slot=0; bus_base_rms=0;
        ) : (
          bus_slots_full=0;
        );
      );
    );
  );

  // refresh ownership of the held/owned Bus slot
  (bus_claim_state==2 && bus_my_slot>=1) ? (
    bus_slots_full = 0;
    (bus_held_slot>=1 && bus_held_slot!=bus_my_slot) ? ( bho=CNF_BUSROLE_BASE+(bus_held_slot-1)*CNF_STRIDE; gmem[bho+12]=0; gmem[bho+0]=0; gmem[bho+1]=0; );
    boo=CNF_BUSROLE_BASE+(bus_my_slot-1)*CNF_STRIDE;
    gmem[boo+12]=my_id; gmem[boo+0]=now; gmem[boo+1]=1; gmem[boo+2]=0; gmem[boo+3]=0;
    gmem[boo+13]=CNF_VERSION; gmem[boo+14]=0;
    bus_held_slot=bus_my_slot;
  );

  // Bus-pool counts for the status UI (display only; computed here so they are correct
  // even when the plugin window is closed; @gfx only reads these, never writes ownership).
  // Count only non-stale, active, untopologized Bus slots in the Bus pool.
  bcnt=0; bi=1;
  loop(CNF_BUSROLE_SLOTS,
    bo=CNF_BUSROLE_BASE+(bi-1)*CNF_STRIDE;
    (gmem[bo+1]==1 && gmem[bo+2]==0 && gmem[bo+3]==0 && (now-gmem[bo+0]) < TIMEOUT) ? ( bcnt+=1; );
    bi+=1;
  );
  bus_assigned_count  = bcnt;                                   // M
  bus_available_count = CNF_BUSROLE_SLOTS - bcnt; bus_available_count < 0 ? bus_available_count = 0;  // K
  bus_display_num     = (bus_claim_state==2 && bus_my_slot>=1) ? bus_my_slot : 0;  // N (0 = not owned yet)

  // emit gating: silent without VERIFIED Bus ownership AND a live Master AND on-state.
  master_present = (now - gmem[4]) < TIMEOUT;
  mi = gmem[2];
  bus_emit = (bus_claim_state==2 && bus_my_slot>=1) && master_present && (mi>0);
  // Base target; @sample multiplies in the glacial activity gain (1.0 .. depth).
  bus_base_rms = bus_emit ? db2lin(m_busrole_level) * mi : 0;
  tgt_rms = bus_base_rms;
) : (
  // ================= MASTER (authority) =================
  (held_slot>=1) ? ( ho=CNF_BASE+(held_slot-1)*CNF_STRIDE; gmem[ho+12]=0; gmem[ho+0]=0; gmem[ho+1]=0; held_slot=0; );
  (bus_held_slot>=1) ? ( bho=CNF_BUSROLE_BASE+(bus_held_slot-1)*CNF_STRIDE; gmem[bho+12]=0; gmem[bho+0]=0; gmem[bho+1]=0; bus_held_slot=0; );
  // Hard-Off-On-Stop is GLOBAL: publish the EFFECTIVE intensity so Channel
  // followers (which read gmem[2]) and hum go silent on transport stop too.
  play_ok = 1;
  hum_sel = 0; // Hum buttons removed; keep hum path hard-disabled in product build
  pub_int = (play_ok && (cnf_bypass==0)) ? 1 : 0;
  gmem[2]=pub_int; gmem[3]=1; gmem[4]=now; gmem[8]=cnf_bypass;  // gmem[3]=1: constant, no character mode
  // Publish the Noise Floor Level boost to followers (linear gain + dB for display).
  // This is a boost above the calibrated floor; on/off is still governed by gmem[2]/pub_int.
  gmem[9]=db2lin(cnf_noise_level_db); gmem[10]=cnf_noise_level_db;

  // multiple-master guard (shared claim slot, alternating writes)
  oid=gmem[6]; ohb=gmem[7];
  (oid != my_id && oid != 0 && (now - ohb) < TIMEOUT) ? ( multi_seen=now; );
  gmem[6]=my_id; gmem[7]=now;
  multi_active = (now - multi_seen) < 1.5;

  cnt=0; hi=0; i=1;
  loop(CNF_MAX_SLOTS,
    o=CNF_BASE+(i-1)*CNF_STRIDE;
    (gmem[o+1]==1 && gmem[o+2]==0 && gmem[o+3]==0 && (now-gmem[o+0]) < TIMEOUT) ? ( cnt+=1; hi=i; );
    i+=1;
  );
  gmem[5]=cnt; dbg_count=cnt; dbg_highest=hi;

  // Count active Bus followers for the fixed-reference A/B compensation model.
  mbcnt=0; mbi=1;
  loop(CNF_BUSROLE_SLOTS,
    mbo=CNF_BUSROLE_BASE+(mbi-1)*CNF_STRIDE;
    (gmem[mbo+1]==1 && gmem[mbo+2]==0 && gmem[mbo+3]==0 && (now-gmem[mbo+0]) < TIMEOUT) ? ( mbcnt+=1; );
    mbi+=1;
  );

  bus_load = db2lin(m_busper) * sqrt(cnt) * m_buildup;
  bus_amp  = db2lin(m_busamp);
  out_amp  = db2lin(m_outamp);
  pre      = sqrt(bus_load*bus_load + bus_amp*bus_amp);
  finalr   = sqrt(pre*pre + out_amp*out_amp);

  tgt_rms = (pub_int > 0) ? finalr * pub_int : 0;

  // Fixed, non-program-dependent estimate of generated CNF floor energy at the Master output.
  // Channel/Bus counts are uncorrelated-energy estimates; finalr is the Master-owned floor model.
  // Noise Floor Level is included as a target gain, then the actual trim is smoothed in @sample.
  ab_ch_rms  = db2lin(m_chfloor) * sqrt(cnt);
  ab_bus_rms = db2lin(m_busrole_level) * sqrt(mbcnt);
  ab_mst_rms = finalr;
  ab_nl_lin  = db2lin(cnf_noise_level_db);
  abcomp_noise_rms = (pub_int > 0) ? sqrt(ab_ch_rms*ab_ch_rms + ab_bus_rms*ab_bus_rms + ab_mst_rms*ab_mst_rms) * ab_nl_lin : 0;
);

// --- Noise Floor Level target (boost above calibrated floor) ---
// Master uses its own knob value; followers use the Master-published gain (gmem[9]) while a
// Master heartbeat is live (else they are silent anyway). Boost-only: never below unity.
// Master fade smoothing, refreshed from the current srate (~150 ms).
smc = 1 - exp(-1/(srate*0.15));      // ~150 ms level smoothing
// nl_smc is recomputed here from the current srate (sample-rate-safe), like ahp/alp/bus_act_coef.
nl_smc = 1 - exp(-1/(srate*0.05));   // ~50 ms, click-free
topology==1 ? (
  nl_target = db2lin(cnf_noise_level_db);
) : (
  nl_target = ((now - gmem[4]) < TIMEOUT) ? gmem[9] : 1;
);
nl_target < 1 ? nl_target = 1;

// --- Master-owned A/B level compensation target ---
// gain = 1/sqrt(1 + (generated_floor_rms / fixed_reference_rms)^2), bounded by max cut.
// This never reads program loudness and therefore cannot pump, chase level, gate, or compress.
abcomp_smc = 1 - exp(-1/(srate*0.05));
abcomp_ref = db2lin(CNF_ABCOMP_REFERENCE_DB);
abcomp_min = db2lin(-CNF_ABCOMP_MAX_CUT_DB);
(topology==1 && cnf_abcomp > 0.5 && abcomp_noise_rms > 0 && abcomp_ref > 0) ? (
  abcomp_ratio = abcomp_noise_rms / abcomp_ref;
  abcomp_target = 1 / sqrt(1 + abcomp_ratio*abcomp_ratio);
  abcomp_target < abcomp_min ? abcomp_target = abcomp_min;
) : (
  abcomp_target = 1;
);

@sample
// === FACELIFT BEGIN sample_start v1 ===
// === FACELIFT END sample_start ===
cnf_noise_peak = 0;
// --- Bus activity detector (Bus role only): glacial, reads clean program input ---
// Conservative proxy for bus load. ONE slow one-pole (no fast envelope, no pumping).
// Movement is bounded by CNF_BUSROLE_ACTIVITY_DEPTH_DB (<= ~1 dB). Read BEFORE noise add.
topology==2 ? (
  inmag = (abs(spl0)+abs(spl1))*0.5;
  bus_act_env += (inmag - bus_act_env) * bus_act_coef;
  bus_act_env < 0.0000000001 ? bus_act_env = 0;   // denormal guard on the slow envelope
  bus_ag = bus_act_env * CNF_BUSROLE_ACTIVITY_SENS;
  bus_ag > 1 ? bus_ag = 1;
  bus_act_gain = 1 + bus_ag * (bus_act_depth_lin - 1);   // 1.0 .. depth, tiny
  tgt_rms = bus_base_rms * bus_act_gain;
);

cur_rms += (tgt_rms - cur_rms) * smc;
// Noise Floor Level boost gain, smoothed (one cheap one-pole) to prevent zipper/clicks when
// the knob/numbox changes. At 0 dB nl_gain == 1.0 (exact), so output is unchanged.
nl_gain += (nl_target - nl_gain) * nl_smc;
topology==1 ? (
  abcomp_gain += (abcomp_target - abcomp_gain) * abcomp_smc;
  abs(abcomp_gain - abcomp_target) < 0.000000000001 ? abcomp_gain = abcomp_target;
) : (
  abcomp_gain = 1;
);

cur_rms < 0.0000000001 ? (
  // Denormal guard: once the fade is done, snap cur_rms to exact 0.
  cur_rms = 0;
  // One-shot idle clear: reset the generator state once per idle transition.
  cnf_silent_cleared == 0 ? (
    fL.hpz=fL.lpz=fL.dcx=fL.dcy=0;
    fR.hpz=fR.lpz=fR.dcx=fR.dcy=0;
    pk_l.b0=pk_l.b1=pk_l.b2=pk_l.b3=pk_l.b4=pk_l.b5=pk_l.b6=0;
    pk_r.b0=pk_r.b1=pk_r.b2=pk_r.b3=pk_r.b4=pk_r.b5=pk_r.b6=0;
    pk_s.b0=pk_s.b1=pk_s.b2=pk_s.b3=pk_s.b4=pk_s.b5=pk_s.b6=0;
    cnf_silent_cleared = 1;
  );
) : (
  cnf_silent_cleared = 0;  // re-arm the one-shot clear before active generation
  // noise_amp: computed once per active sample, after the smoothers above.
  noise_amp = cur_rms * nl_gain;
  topology==2 ? (
    // ---- BUS generator: warmer/denser, partly L/R-correlated, smoother top ----
    // Independent L/R streams (reuse the per-instance L/R RNG; topology is exclusive).
    // Pink inputs stay nrand(rp_x)*SQRT3; blend and SQRT3 multiplies are folded into bus_kW/bus_kP/bus_kW3.
    wl = nrand(rw_l);
    pl_raw = pink_next(pk_l, nrand(rp_l)*SQRT3);
    indL = bus_kW3*wl + bus_kP*pl_raw;
    wr = nrand(rw_r);
    pr_raw = pink_next(pk_r, nrand(rp_r)*SQRT3);
    indR = bus_kW3*wr + bus_kP*pr_raw;
    // Shared (L/R-correlated) component: subtle common bus-electronics noise, not mono.
    ws = nrand(rw_s);
    ps_raw = pink_next(pk_s, nrand(rp_s)*SQRT3);
    shr = bus_kW3*ws + bus_kP*ps_raw;
    // Mix independent + shared. No extra normalize here: the slight RMS rise from the
    // shared add is absorbed by CNF_BUSROLE_LEVEL_DB / CNF_BUSROLE_PRODUCT_TRIM_DB.
    bmL = indL + busShared*shr;
    bmR = indR + busShared*shr;
    sL  = shape(fL, bmL*noise_amp);   // fL/fR carry Bus HP/LP coefficients while topology==2
    sR  = shape(fR, bmR*noise_amp);
    spl0 += sL; spl1 += sR;
    cnf_noise_peak = max(abs(sL), abs(sR));
  ) : (
    // ---- CHANNEL / MASTER generator ----
    // Pink inputs stay nrand(rp_x)*SQRT3; blend and SQRT3 multiplies are folded into kW/kP/kW3.
    wl = nrand(rw_l);
    pl_raw = pink_next(pk_l, nrand(rp_l)*SQRT3);
    blL = kW3*wl + kP*pl_raw;
    sL  = shape(fL, blL*noise_amp);
    wr = nrand(rw_r);
    pr_raw = pink_next(pk_r, nrand(rp_r)*SQRT3);
    blR = kW3*wr + kP*pr_raw;
    sR  = shape(fR, blR*noise_amp);
    (topology==1 && hum_sel>0 && pub_int>0) ? (
      humf  = hum_sel==1 ? 50 : 60;
      humph += 2*$pi*humf/srate; humph >= 2*$pi ? humph -= 2*$pi;
      humbase = -104;   // hum is hard-disabled (hum_sel=0 always); character no longer referenced
      hlin = db2lin(humbase) * pub_int;
      hsig = hlin*( sin(humph) + 0.25*sin(2*humph) + 0.12*sin(3*humph) );
      sL += hsig; sR += hsig;
    );
    spl0 += sL; spl1 += sR;
    cnf_noise_peak = max(abs(sL), abs(sR));
  );
);

// Master-only A/B compensation. Applied after CNF noise generation so it trims the
// combined output by a bounded, smoothed fixed-reference amount. Followers never compensate.
topology==1 ? ( spl0 *= abcomp_gain; spl1 *= abcomp_gain; );

// === FACELIFT BEGIN sample_end v1 ===
cnf_noise_peak * 0 == 0 ? (
  fl47bdb600_read_last1 = cnf_noise_peak;
  fl47bdb600_read_set1 ? (
    fl47bdb600_read_lo1 = min(fl47bdb600_read_lo1, cnf_noise_peak);
    fl47bdb600_read_hi1 = max(fl47bdb600_read_hi1, cnf_noise_peak);
  ) : (
    fl47bdb600_read_lo1 = cnf_noise_peak;
    fl47bdb600_read_hi1 = cnf_noise_peak;
    fl47bdb600_read_set1 = 1;
  );
) : (
  fl47bdb600_read_last1 = 0;
);
// === FACELIFT END sample_end ===
@gfx 734 386
cnf_embedded_tcp_mcp = (gfx_ext_flags & 1);
cnf_noise_peak; // read here so Facelift Import lists it



cnf_embedded_tcp_mcp ? (
  // ===========================================================================
  // @gfx REGION: EMBEDDED VIEW (TCP/MCP micro-view) -- BEGIN
  // This view writes only UI state (cnf_bypass, cnf_noise_level_db), never gmem.
  // ===========================================================================
  // TCP/MCP embedded micro-view. Embedded mode is not the normal CNF
  // faceplate: no full UI/header/guard/help/info/faceplate drawing. Master is
  // the only embedded role allowed to change CNF Noise Floor On/Off. Channel
  // and Bus show role identity only and do not send follower-to-Master commands.
  gfx_ext_flags = gfx_ext_flags | 256;

  // Refresh modifier state before reading mouse_cap. gfx_getchar(65536) is the
  // documented window-state query and keeps keyboard modifier bits current for
  // embedded mouse handling.
  emb_win_flags = gfx_getchar(65536);

  emb_mdown = mouse_cap & 1;
  emb_shift = mouse_cap & 8;
  emb_mods = mouse_cap & 60; // Ctrl/Cmd, Shift, Alt/Option, Win/Ctrl.
  emb_plain = (emb_mods == 0);
  emb_down_edge = emb_mdown && (emb_mouse_was == 0);
  (emb_plain == 0) ? emb_level_drag_active = 0;

  // Stale-flag prevention: clear open-UI pass-through at the start of every
  // embedded frame. Re-enable it only for the current frame and only when the
  // current mouse position is inside a host-open zone. This prevents old plain
  // clickability state from surviving into Shift or other modified gestures.
  (gfx_ext_flags & 512) ? gfx_ext_flags -= 512;
  emb_openui = 0;

  emb_now = time_precise();
  emb_role = master_latch ? 1 : (follower_role == 1 ? 2 : 0);
  emb_master_live = ((emb_now - gmem[4]) < TIMEOUT);
  emb_bus_full = (emb_role == 2) && ((bus_slots_full > 0.5) || (bus_full_latched > 0.5));
  emb_noise_off = emb_role == 1 ? (cnf_bypass > 0.5) : ((emb_master_live == 0) || (gmem[8] > 0.5));
  emb_dim = emb_noise_off || emb_bus_full;

  // JSFX exposes generic TCP/MCP embedded detection through gfx_ext_flags bit 1,
  // but not a documented TCP-vs-MCP identity bit, so a width/height heuristic
  // picks the layout:
  // wide embedded rectangles receive a compact right-anchored visible badge,
  // while tall/narrow insert-like rectangles keep a centered MCP-style badge.
  emb_gw = gfx_w;
  emb_gh = gfx_h;
  emb_gw < 1 ? emb_gw = 1;
  emb_gh < 1 ? emb_gh = 1;
  emb_tcp_like = (emb_gw >= 96) && (emb_gw >= emb_gh * 2.0);

  // Deterministic repaint every embedded frame. Clear the actual embedded
  // framebuffer to neutral black so stale header/Console Noise/overlay residue
  // cannot be CNF-owned. Then draw a fill-only badge inset from host edges.
  // No outline, stroke, bevel, accent line, side edge, lower edge, or normal
  // faceplate element is drawn.
  gfx_mode = 0;
  gfx_dest = -1;
  gfx_clear = 0;
  gfx_set(0.000,0.000,0.000,1);
  gfx_rect(0,0,emb_gw,emb_gh);

  emb_edge_inset = 1;
  emb_tcp_like ? (
    // TCP-like: draw a compact visual badge locked to the right edge of the
    // host-provided embedded area. The left side may change with resize; the
    // right edge remains visually anchored.
    emb_badge_w = emb_gw * 0.46;
    emb_badge_w > 210 ? emb_badge_w = 210;
    emb_badge_w < 96 ? emb_badge_w = 96;
    emb_badge_w > emb_gw - emb_edge_inset ? emb_badge_w = emb_gw - emb_edge_inset;
    emb_badge_w < 1 ? emb_badge_w = 1;

    emb_badge_h = emb_role == 1 ? 56 : 40;
    emb_badge_h > emb_gh - emb_edge_inset*2 ? emb_badge_h = emb_gh - emb_edge_inset*2;
    emb_badge_h < 1 ? emb_badge_h = 1;
    emb_x = emb_gw - emb_badge_w - emb_edge_inset;
