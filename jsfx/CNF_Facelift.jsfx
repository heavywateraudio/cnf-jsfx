  tmp[4] = hover_b_r;
  tmp[5] = hover_b_g;
  tmp[6] = hover_b_b;
  tmp[7] = hover_b_a;
  tmp[8] = inner_ring_a_r;
  tmp[9] = inner_ring_a_g;
