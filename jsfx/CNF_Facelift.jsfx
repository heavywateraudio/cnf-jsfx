    row == 34 ? 0        :
    row == 35 ? 1        :
    row == 36 ? 0        :
    row == 37 ? 1        :
    row == 38 ? 0        :
    row == 39 ? 1        :
    row == 40 ? 0        :
                0.2;
  ) : channel == 1 ? (
    row == 0  ? 0.090196 :
    row == 1  ? 0.031373 :
    row == 2  ? 0.384314 :
    row == 3  ? 0.360784 :
    row == 4  ? 0.94902  :
    row == 5  ? 0.737255 :
    row == 6  ? 0.486275 :
    row == 7  ? 0.117647 :
    row == 8  ? 0.580392 :
    row == 9  ? 0.741176 :
    row == 10 ? 0.94902  :
    row == 11 ? 0.819608 :
    row == 12 ? 0.819608 :
    row == 13 ? 0.168627 :
    row == 14 ? 0.360784 :
    row == 15 ? 0.94902  :
    row == 16 ? 0.301961 :
    row == 17 ? 0.988235 :
    row == 18 ? 0.819608 :
    row == 19 ? 1        :
    row == 20 ? 1        :
    row == 21 ? 0        :
    row == 22 ? 0.011765 :
    row == 23 ? 0.070588 :
    row == 24 ? 0.819608 :
    row == 26 ? 0.580392 :
    row == 27 ? 0.090196 :
    row == 28 ? 0.031373 :
    row == 29 ? 1        :
    row == 30 ? 0        :
    row == 31 ? 1        :
    row == 32 ? 0        :
    row == 33 ? 1        :
    row == 34 ? 0        :
    row == 35 ? 1        :
    row == 36 ? 0        :
    row == 37 ? 1        :
    row == 38 ? 0        :
    row == 39 ? 1        :
    row == 40 ? 0        :
                0.2;
  ) : (
    row == 0  ? 0.109804 :
    row == 1  ? 0.039216 :
    row == 2  ? 0.384314 :
    row == 3  ? 0.329412 :
    row == 4  ? 0.988235 :
    row == 5  ? 0.737255 :
    row == 6  ? 0.443137 :
    row == 7  ? 0.117647 :
    row == 8  ? 0.619608 :
